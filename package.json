{
  "name": "can-tiyatrosu",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tinacms dev -p 4002 --datalayer-port 9001 -c \"astro dev --host 127.0.0.1 --port 4321\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tinacms build -p 4002 --local --skip-cloud-checks --skip-indexing --skip-search-index --datalayer-port 9001 && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/astro": "^0.6.1",
    "@tinacms/cli": "^2.5.6",
    "@tinacms/datalayer": "^2.0.29",
    "astro": "^7.2.0",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@types/node": "^26.1.2",
    "@vite-pwa/astro": "^1.2.0",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "@vite-pwa/astro": {
      "astro": "$astro"
    }
  }
}
