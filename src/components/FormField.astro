---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'date' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  options?: string[];
  rows?: number;
}
const { label, name, type = 'text', required = false, placeholder, options = [], rows = 5 } = Astro.props;
const id = `field-${name}`;
---
<div class="flex flex-col gap-2">
  <label for={id} class="text-sm font-semibold text-ink">
    {label}{required && <span class="text-curtain"> *</span>}
  </label>
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      required={required}
      placeholder={placeholder}
      rows={rows}
      class="w-full rounded-[2px] border border-hairline bg-paper px-4 py-3 text-ink placeholder:text-stone-light focus:border-curtain focus:outline-none transition-colors"
    ></textarea>
  ) : type === 'select' ? (
    <select
      id={id}
      name={name}
      required={required}
      class="w-full rounded-[2px] border border-hairline bg-paper px-4 py-3 text-ink focus:border-curtain focus:outline-none transition-colors"
    >
      <option value="" disabled selected>Seçiniz</option>
      {options.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required={required}
      placeholder={placeholder}
      class="w-full rounded-[2px] border border-hairline bg-paper px-4 py-3 text-ink placeholder:text-stone-light focus:border-curtain focus:outline-none transition-colors"
    />
  )}
</div>
