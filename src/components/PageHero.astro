---
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  eyebrowField?: string;
  titleField?: string;
  ledeField?: string;
}
const { eyebrow, title, lede, eyebrowField, titleField, ledeField } = Astro.props;
---
<header class="border-b border-hairline bg-paper-dim pt-32 pb-16 md:pt-40 md:pb-20">
  <Container>
    <div class="max-w-3xl">
      {eyebrow && (
        <p class="eyebrow mb-5" data-tina-field={eyebrowField}>
          {eyebrow}
        </p>
      )}
      <h1 class="text-4xl md:text-6xl" data-tina-field={titleField}>{title}</h1>
      {lede && (
        <p class="mt-6 text-lg md:text-xl text-stone max-w-2xl" data-tina-field={ledeField}>
          {lede}
        </p>
      )}
    </div>
  </Container>
</header>
