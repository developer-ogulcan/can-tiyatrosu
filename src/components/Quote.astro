---
interface Props {
  attribution?: string;
  role?: string;
}
const { attribution, role } = Astro.props;
---
<figure class="max-w-3xl">
  <blockquote class="font-display text-2xl md:text-4xl italic leading-snug text-ink">
    “<slot />”
  </blockquote>
  {attribution && (
    <figcaption class="mt-5 text-sm">
      <span class="font-semibold">{attribution}</span>
      {role && <span class="text-stone"> — {role}</span>}
    </figcaption>
  )}
</figure>
