---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-[2px] px-6 py-3 text-sm font-semibold tracking-wide transition-colors duration-200';

const variants: Record<string, string> = {
  primary: 'bg-ink text-paper hover:bg-curtain-deep',
  secondary: 'border border-ink/25 text-ink hover:border-curtain hover:text-curtain',
  ghost: 'text-ink hover:text-curtain underline decoration-gold/60 decoration-2 underline-offset-4',
};

const classes = `${base} ${variants[variant]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class={classes}
>
  <slot />
</Tag>
