---
interface TimelineEntry {
  perde: string;
  year: string;
  title: string;
  description: string;
}
interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;
---
<ol class="relative">
  {entries.map((entry, i) => (
    <li class="relative pl-10 md:pl-14 pb-14 last:pb-0 border-l border-hairline last:border-transparent">
      <span class="absolute -left-[7px] top-1 w-3.5 h-3.5 rounded-full bg-paper border-2 border-gold-deep"></span>
      <p class="eyebrow mb-2">{entry.perde} · {entry.year}</p>
      <h3 class="text-2xl md:text-3xl mb-3">{entry.title}</h3>
      <p class="text-stone leading-relaxed max-w-2xl">{entry.description}</p>
    </li>
  ))}
</ol>
