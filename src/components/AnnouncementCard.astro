---
interface Props {
  title: string;
  date: Date;
  summary: string;
  href?: string;
}
const { title, date, summary, href } = Astro.props;
const formatted = date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="border-t border-hairline py-7 first:border-t-0">
  <p class="text-xs uppercase tracking-wide text-stone-light mb-2">{formatted}</p>
  {href ? (
    <a href={href} class="text-xl md:text-2xl font-display hover:text-curtain transition-colors">{title}</a>
  ) : (
    <h3 class="text-xl md:text-2xl">{title}</h3>
  )}
  <p class="mt-2 text-stone leading-relaxed max-w-2xl">{summary}</p>
</article>
