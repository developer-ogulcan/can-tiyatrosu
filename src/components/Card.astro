---
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  href={href}
  class:list={[
    'group block bg-paper border border-hairline rounded-[3px] p-7 md:p-8 transition-all duration-300',
    href ? 'hover:border-gold-deep/50 hover:shadow-[var(--shadow-card)] hover:-translate-y-0.5' : '',
    className,
  ]}
>
  <slot />
</Tag>
