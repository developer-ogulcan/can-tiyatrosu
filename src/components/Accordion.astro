---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-hairline border-t border-b border-hairline">
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer items-center justify-between gap-6 text-lg font-medium marker:content-none list-none">
        <span>{item.question}</span>
        <span class="shrink-0 text-gold-deep transition-transform duration-200 group-open:rotate-45 text-2xl leading-none" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-stone leading-relaxed max-w-2xl">{item.answer}</p>
    </details>
  ))}
</div>
