---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  ctas?: { label: string; href: string }[];
}
const { eyebrow, title, lede, ctas = [] } = Astro.props;
---
<section class="relative min-h-[64vh] md:min-h-[72vh] lg:min-h-[88vh] overflow-hidden bg-ink text-paper">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(255,200,60,0.06)_0,transparent_30%),radial-gradient(circle_at(85%_20%),rgba(214,40,40,0.04)_0,transparent_25%)]"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-[linear-gradient(180deg,rgba(10,8,6,0.95),transparent)] pointer-events-none"></div>

  <div class="container-editorial relative z-10 flex flex-col justify-center min-h-[64vh] md:min-h-[72vh] lg:min-h-[88vh]">
    {eyebrow && <p class="eyebrow text-gold mb-6">{eyebrow}</p>}
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.96] max-w-4xl">{title}</h1>
    {lede && <p class="mt-6 text-lg md:text-xl text-paper/80 max-w-3xl">{lede}</p>}

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/bilet" class="inline-flex items-center gap-3 rounded-md bg-curtain px-6 py-3 text-sm font-semibold shadow-[0_6px_30px_rgba(214,40,40,0.15)] hover:bg-curtain-deep transition-colors">Bilet Al</a>
      <a href="/performanslar" class="inline-flex items-center gap-3 rounded-md border border-paper/20 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:bg-paper/5 transition-colors">Sahnelenenleri Gör</a>
      <a href="/basvurular/can-akademi" class="inline-flex items-center gap-3 rounded-md border border-paper/10 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:underline">Çan Akademi</a>
      <a href="/basvurular/kurumsal-gosterim-talebi" class="inline-flex items-center gap-3 rounded-md border border-paper/10 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:underline">Gösterim Talebi</a>
    </div>
  </div>

  <svg class="absolute inset-x-0 bottom-0 w-full" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden>
    <path d="M0,0 C200,60 400,60 600,0 C800,-60 1000,-60 1200,0 L1200,60 L0,60 Z" fill="url(#fade)" fill-opacity="0.35"></path>
    <defs>
      <linearGradient id="fade" x1="0" x2="1">
        <stop offset="0%" stop-color="#000" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#000" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</section>
