---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  ctas?: { label: string; href: string }[];
}
const { eyebrow, title, lede, ctas = [] } = Astro.props;
---
<section
  class="relative min-h-[64vh] md:min-h-[72vh] lg:min-h-[88vh] overflow-hidden text-paper"
  style="background-image: linear-gradient(180deg, rgba(17,17,17,0.65), rgba(17,17,17,0.35)), url('/images/hero-stock.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;"
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(246,194,30,0.06)_0,transparent_30%),radial-gradient(circle_at(85%_20%),rgba(182,30,46,0.04)_0,transparent_25%)] pointer-events-none"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-[rgba(17,17,17,0.95)] to-transparent pointer-events-none"></div>

  <div class="container-editorial relative z-10 flex flex-col justify-center min-h-[64vh] md:min-h-[72vh] lg:min-h-[88vh]">
    {eyebrow && <p class="eyebrow text-gold mb-6">{eyebrow}</p>}
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.96] max-w-4xl">{title}</h1>
    {lede && <p class="mt-6 text-lg md:text-xl text-paper/80 max-w-3xl">{lede}</p>}

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/bilet" class="inline-flex items-center gap-3 rounded-md bg-ct-yellow text-ct-black px-6 py-3 text-sm font-semibold shadow-hero-lg hover:bg-[#e6b214] transition-colors">Bilet Al</a>
      <a href="/performanslar" class="inline-flex items-center gap-3 rounded-md border border-white/20 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:bg-white/5 transition-colors">Oyunlar</a>
      <a href="/can-akademi" class="inline-flex items-center gap-3 rounded-md border border-white/10 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:underline">Çan Akademi</a>
      <a href="/performanslar" class="inline-flex items-center gap-3 rounded-md border border-white/10 bg-transparent px-6 py-3 text-sm font-semibold text-paper hover:underline">Takvim</a>
    </div>
  </div>

  <svg class="absolute inset-x-0 bottom-0 w-full" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden>
    <path d="M0,0 C200,60 400,60 600,0 C800,-60 1000,-60 1200,0 L1200,60 L0,60 Z" fill="url(#fade)" fill-opacity="0.35"></path>
    <defs>
      <linearGradient id="fade" x1="0" x2="1">
        <stop offset="0%" stop-color="#000" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#000" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</section>
