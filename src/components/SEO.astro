---
import { getCollection } from 'astro:content';
import { SITE, NAV } from '../lib/site';

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  type = 'website',
  publishedTime,
  jsonLd,
  breadcrumbs,
} = Astro.props;

/* ---------- Tina verileri ---------- */
let seo: any = {};
try {
  const entries = await getCollection('seo');
  seo = entries[0]?.data ?? {};
} catch (e) {
  seo = {};
}

let pageOverrides: any[] = [];
try {
  const entries = await getCollection('pageSeo');
  pageOverrides = entries[0]?.data?.pages ?? [];
} catch (e) {
  pageOverrides = [];
}

/* ---------- Yardımcılar ---------- */
const norm = (p?: string) => {
  const s = (p ?? '').trim().replace(/\/+$/, '');
  return s === '' ? '/' : s.startsWith('/') ? s : `/${s}`;
};

const clamp = (text: string, max = 160) => {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 60 ? cut.slice(0, lastSpace) : cut).trim()}…`;
};

const origin = (Astro.site ?? Astro.url).origin;
const abs = (u: string) => new URL(u, origin).href;

const path = norm(Astro.url.pathname);
const isHome = path === '/';
const canonicalURL = isHome ? `${origin}/` : `${origin}${path}`;

const override = pageOverrides.find((p) => norm(p?.path) === path);

/* ---------- Başlık ---------- */
const suffix = seo.titleSuffix || SITE.name;
let pageTitle: string;
if (override?.title) {
  pageTitle = override.title;
} else if (isHome) {
  pageTitle = seo.defaultTitle || title;
} else if (title.includes(SITE.name)) {
  pageTitle = title;
} else {
  pageTitle = `${title} | ${suffix}`;
}

/* ---------- Açıklama ---------- */
const metaDescription = clamp(
  override?.description || description || seo.defaultDescription || SITE.description,
);

/* ---------- Görsel ---------- */
const chosenImage = override?.image || image || seo.defaultOgImage;
const isFallbackImage = !chosenImage;
const ogImageURL = abs(chosenImage || '/images/og-default.jpg');
const ogImageAlt = imageAlt || (isFallbackImage ? seo.ogImageAlt : undefined) || title || SITE.name;

/* ---------- Robots ---------- */
const isNoindex = noindex || !!override?.noindex;
const robots = isNoindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

/* ---------- Breadcrumb ---------- */
const labelMap = new Map<string, string>();
NAV.forEach((item) => {
  labelMap.set(norm(item.href), item.label);
  item.children?.forEach((c) => {
    if (!labelMap.has(norm(c.href))) labelMap.set(norm(c.href), c.label);
  });
});

const segments = path.split('/').filter(Boolean);
const autoCrumbs: Breadcrumb[] = [{ name: 'Anasayfa', href: '/' }];
let acc = '';
segments.forEach((seg, i) => {
  acc += `/${seg}`;
  const isLast = i === segments.length - 1;
  const label = isLast ? title.split(' | ')[0] : labelMap.get(acc);
  if (label) autoCrumbs.push({ name: label, href: acc });
});
const crumbs = breadcrumbs ?? (segments.length ? autoCrumbs : []);

/* ---------- Yapılandırılmış veri ---------- */
const orgId = `${origin}/#organization`;
const websiteId = `${origin}/#website`;
const logoUrl = abs(seo.logo || '/images/logo.png');

const organization: Record<string, unknown> = {
  '@type': ['TheaterGroup', 'LocalBusiness'],
  '@id': orgId,
  name: SITE.name,
  alternateName: `${SITE.name} Ankara`,
  url: `${origin}/`,
  logo: { '@type': 'ImageObject', url: logoUrl },
  image: logoUrl,
  description: seo.organizationDescription || SITE.description,
  slogan: SITE.tagline,
  foundingDate: String(SITE.founded),
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sağlık Mahallesi, Süleyman Sırrı Caddesi No: 12 Daire: 5 ve 6, Sıhhiye',
    addressLocality: 'Çankaya',
    addressRegion: 'Ankara',
    addressCountry: 'TR',
  },
  areaServed: { '@type': 'City', name: 'Ankara' },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '10:00',
      closes: '14:00',
    },
  ],
  sameAs: SITE.social.map((s) => s.href),
};
if (seo.priceRange) organization.priceRange = seo.priceRange;
if (typeof seo.geoLat === 'number' && typeof seo.geoLng === 'number') {
  organization.geo = {
    '@type': 'GeoCoordinates',
    latitude: seo.geoLat,
    longitude: seo.geoLng,
  };
}

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${origin}/`,
  name: SITE.name,
  inLanguage: 'tr-TR',
  publisher: { '@id': orgId },
};

const webpage: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: pageTitle,
  description: metaDescription,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': websiteId },
  about: { '@id': orgId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageURL },
};

const graph: Record<string, unknown>[] = [organization, website, webpage];

if (crumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.href),
    })),
  });
  webpage.breadcrumb = { '@id': `${canonicalURL}#breadcrumb` };
}

if (jsonLd) {
  (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).forEach((item) => graph.push(item));
}

const jsonLdString = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c',
);

const published = publishedTime ? new Date(publishedTime).toISOString() : undefined;
---

<!-- Temel SEO -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={metaDescription} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="tr" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<meta name="theme-color" content="#000000" />
<meta name="geo.region" content="TR-06" />
<meta name="geo.placename" content="Ankara" />

<!-- Arama motoru doğrulama (Tina > SEO) -->
{seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification} />}
{seo.bingSiteVerification && <meta name="msvalidate.01" content={seo.bingSiteVerification} />}
{seo.yandexVerification && <meta name="yandex-verification" content={seo.yandexVerification} />}

<!-- Open Graph (Facebook / WhatsApp / LinkedIn / Telegram) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={ogImageAlt} />
{isFallbackImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{type === 'article' && published && <meta property="article:published_time" content={published} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Yapılandırılmış veri (JSON-LD) -->
<script type="application/ld+json" set:html={jsonLdString} />