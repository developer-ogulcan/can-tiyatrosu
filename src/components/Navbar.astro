---
import { NAV } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="fixed top-0 inset-x-0 z-50 border-b-2 border-curtain/20 bg-paper/95 backdrop-blur-sm">
  <div class="container-editorial flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Çan Tiyatrosu">
      <img src="/images/logo.png" alt="Çan Tiyatrosu" class="h-14 w-auto" />
    </a>

<nav class="hidden xl:flex items-center gap-1" aria-label="Ana menü">
      {NAV.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 text-xs uppercase tracking-wider font-bold transition-colors rounded-md inline-flex items-center gap-1',
              isActive(item.href) ? 'text-curtain' : 'text-ink/80 hover:text-curtain',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1 min-w-[210px]">
              <div class="bg-paper border border-hairline rounded-lg shadow-lg py-1.5">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-2 text-xs font-semibold text-ink/80 hover:text-curtain hover:bg-paper-dim transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

<!-- Sağ Buton Alanı (Masaüstü) -->
    <div class="hidden lg:flex items-center gap-2.5">
      <a 
        href="/hizmetler/kurumsal-gosterimler" 
        class="text-xs font-semibold text-curtain border border-curtain/40 hover:border-curtain hover:bg-curtain hover:text-paper px-3 py-1.5 rounded transition-all duration-150 whitespace-nowrap"
      >
        Okul / Kreş Gösterimleri
      </a>
      <a href="/bilet" class="btn-primary !py-1.5 !px-4 !text-xs !shadow-none">
        Bilet Al
      </a>
    </div>

    <button
      id="menu-toggle"
      class="xl:hidden p-2 -mr-2 text-curtain"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <!-- Mobil Menü -->
  <div id="mobile-menu" class="xl:hidden hidden border-t-2 border-hairline bg-paper">
    <nav class="container-editorial py-4 flex flex-col" aria-label="Mobil menü">
      {NAV.map((item) => (
        <div class="py-2 border-b border-hairline/60 last:border-b-0">
          <a href={item.href} class="block py-1.5 text-base font-bold text-ink">{item.label}</a>
          {item.children && (
            <div class="pl-3 mt-1 flex flex-col gap-1">
              {item.children.map((child) => (
                <a href={child.href} class="block py-1 text-sm text-stone font-medium">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="mt-4 flex flex-col gap-2">
        <a href="/hizmetler/kurumsal-gosterimler" class="btn-secondary w-full text-center !py-2.5 !text-sm">
          Okul / Kreş Gösterim Talebi
        </a>
        <a href="/bilet" class="btn-primary w-full text-center !py-2.5 !text-sm">
          Bilet Al
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>