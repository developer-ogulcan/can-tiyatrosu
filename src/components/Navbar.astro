---
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="fixed top-0 inset-x-0 z-50 border-b border-hairline/70 bg-paper/90 backdrop-blur-sm">
  <div class="container-editorial flex items-center justify-between h-20">
    <a href="/" class="flex items-baseline gap-2 shrink-0">
      <span class="font-display text-2xl text-ink">Çan</span>
      <span class="font-display text-2xl text-curtain">Tiyatrosu</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Ana menü">
      {NAV.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 text-sm font-medium transition-colors rounded-[2px]',
              isActive(item.href) ? 'text-curtain' : 'text-ink/80 hover:text-curtain',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-150 absolute left-0 top-full pt-2 min-w-[220px]">
              <div class="bg-paper border border-hairline rounded-[3px] shadow-[var(--shadow-card)] py-2">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-4 py-2.5 text-sm text-ink/80 hover:text-curtain hover:bg-paper-dim transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <a
      href="/basvurular/kurumsal-gosterim-talebi"
      class="hidden lg:inline-flex items-center rounded-[2px] bg-ink text-paper px-5 py-2.5 text-sm font-semibold hover:bg-curtain-deep transition-colors"
    >
      Gösterim Talebi
    </a>

    <button
      id="menu-toggle"
      class="lg:hidden p-2 -mr-2"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-hairline bg-paper">
    <nav class="container-editorial py-4 flex flex-col" aria-label="Mobil menü">
      {NAV.map((item) => (
        <div class="py-2 border-b border-hairline/60 last:border-b-0">
          <a href={item.href} class="block py-1.5 text-base font-medium text-ink">{item.label}</a>
          {item.children && (
            <div class="pl-3 mt-1 flex flex-col gap-1">
              {item.children.map((child) => (
                <a href={child.href} class="block py-1 text-sm text-stone">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href="/basvurular/kurumsal-gosterim-talebi" class="mt-4 inline-flex items-center justify-center rounded-[2px] bg-ink text-paper px-5 py-3 text-sm font-semibold">
        Gösterim Talebi
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
