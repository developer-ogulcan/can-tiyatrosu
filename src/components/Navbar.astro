---
import { NAV } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="fixed top-0 inset-x-0 z-50 border-b-2 border-curtain/20 bg-paper/95 backdrop-blur-sm">
  <div class="container-editorial flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Çan Tiyatrosu">
      <img src="/images/logo.png" alt="Çan Tiyatrosu" class="h-14 w-auto" />
    </a>

    <nav class="hidden xl:flex items-center gap-0.5" aria-label="Ana menü">
      {NAV.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              'px-2.5 py-2 text-sm font-semibold transition-colors rounded-md',
              isActive(item.href) ? 'text-curtain' : 'text-ink/85 hover:text-curtain',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-150 absolute left-0 top-full pt-2 min-w-[220px]">
              <div class="bg-paper border-2 border-hairline rounded-lg shadow-[var(--shadow-card)] py-2">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-4 py-2.5 text-sm font-medium text-ink/80 hover:text-curtain hover:bg-paper-dim transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <a href="/bilet" class="hidden lg:inline-flex btn-primary !py-2.5 !px-5 !text-sm !shadow-none">
      Bilet Al
    </a>

    <button
      id="menu-toggle"
      class="xl:hidden p-2 -mr-2 text-curtain"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="xl:hidden hidden border-t-2 border-hairline bg-paper">
    <nav class="container-editorial py-4 flex flex-col" aria-label="Mobil menü">
      {NAV.map((item) => (
        <div class="py-2 border-b border-hairline/60 last:border-b-0">
          <a href={item.href} class="block py-1.5 text-base font-bold text-ink">{item.label}</a>
          {item.children && (
            <div class="pl-3 mt-1 flex flex-col gap-1">
              {item.children.map((child) => (
                <a href={child.href} class="block py-1 text-sm text-stone font-medium">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href="/bilet" class="mt-4 btn-primary w-full text-center">
        Bilet Al
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
