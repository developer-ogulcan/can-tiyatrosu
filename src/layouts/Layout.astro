---
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PopupAd from '../components/PopupAd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  type = 'website',
  publishedTime,
  jsonLd,
  breadcrumbs,
} = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="8828538CF0CA5A7094FCB82A938FD136" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-78DX0SXXCT"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-78DX0SXXCT');
</script>

    <!-- OneSignal Web Push SDK -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script is:inline>
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      OneSignalDeferred.push(async function(OneSignal) {
        await OneSignal.init({
          appId: "d74c27af-8b3f-462a-bb63-8fd7441f8ed0",
        });
      });
    </script>

    { import.meta.env.PROD && <script src="/src/pwa.ts"></script> }
    { import.meta.env.PROD && <script is:inline src="/registerSW.js"></script> }

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      jsonLd={jsonLd}
      breadcrumbs={breadcrumbs}
    />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2266387783305462"
     crossorigin="anonymous"></script>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    Verification: 10d7cc40c25b283e

    <!-- PWA Yükleme Bildirimi (Pop-Up) -->
    <div 
      id="pwa-install-banner" 
      class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-sm bg-ink text-paper p-4 rounded-lg shadow-2xl border border-gold/40 z-50 hidden flex-col gap-3 transition-all duration-300"
    >
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-gold">Mobil Uygulama</span>
        <button id="pwa-close" class="text-paper/60 hover:text-paper text-sm px-1 font-bold" aria-label="Kapat">✕</button>
      </div>
      <p class="text-sm text-paper/90 leading-snug">
        Çan Tiyatrosu uygulamasını mobil cihazınıza yükleyerek biletlere ve duyurulara tek tıkla ulaşın.
      </p>
      <button id="pwa-install-btn" class="btn-primary !py-2 !text-xs !w-full">
        Uygulamayı Yükle
      </button>
    </div>

    <Footer />

    <!-- Açılış pop-up reklamı (Tina > Açılış Pop-up Reklamı) -->
    <PopupAd />

    <script>
      let deferredPrompt: any;
      const banner = document.getElementById('pwa-install-banner');
      const installBtn = document.getElementById('pwa-install-btn');
      const closeBtn = document.getElementById('pwa-close');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (banner) {
          banner.classList.remove('hidden');
          banner.classList.add('flex');
        }
      });

      installBtn?.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'accepted' && banner) {
            banner.classList.add('hidden');
          }
          deferredPrompt = null;
        }
      });

      closeBtn?.addEventListener('click', () => {
        if (banner) {
          banner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>