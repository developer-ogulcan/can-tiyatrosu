---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import PerdeMark from '../components/PerdeMark.astro';
import Quote from '../components/Quote.astro';

const founders = [
  { name: '[Kurucu İsim 1]', title: 'Kurucu Sanat Yönetmeni' },
  { name: '[Kurucu İsim 2]', title: 'Kurucu Ortak' },
];
---

<Layout title="Kurucular" description="Çan Tiyatrosu'nu 1984'te kuran iki isim ve bıraktıkları miras.">
  <PageHero
    eyebrow="Miras"
    title="Kurucular"
    lede="Çan Tiyatrosu, 1984 yılında iki ismin ortak vizyonuyla kuruldu. Kurumun bugün taşıdığı sahne kültürü, onların bıraktığı zeminin üzerine inşa edildi."
  />

  {founders.map((founder, i) => (
    <Section tone={i % 2 === 0 ? 'paper' : 'dim'}>
      <Container>
        <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
          <div class="md:col-span-4 order-1">
            <div class="aspect-[3/4] bg-ink-soft rounded-[2px] flex items-center justify-center">
              <span class="text-paper/30 text-xs uppercase tracking-widest">Portre Alanı</span>
            </div>
          </div>
          <div class="md:col-span-8 order-2">
            <p class="eyebrow mb-4">{founder.title}</p>
            <h2 class="text-4xl md:text-5xl mb-6">{founder.name}</h2>
            <div class="prose-editorial text-lg text-stone leading-relaxed max-w-2xl">
              <p>[Bu kurucunun biyografisi buraya eklenecektir. Sahne kariyeri, kuruma katkıları ve kurumun bugünkü kimliğine olan etkisi anlatılacaktır. Gerçek dışı hiçbir bilgi eklenmeyecek, yalnızca doğrulanmış bilgiler yer alacaktır.]</p>
              <p>[Gerekirse ikinci paragraf buraya eklenecektir.]</p>
            </div>
          </div>
        </div>
      </Container>
    </Section>
  ))}

  <PerdeMark align="center" class="!py-2 bg-paper" />

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Miras</p>
      <h2 class="text-3xl md:text-4xl max-w-2xl mb-10">Bugüne taşınan bir sahne anlayışı</h2>
      <Quote attribution="[İsim eklenecek]" role="Kurucu">
        [Kurucuların sahne anlayışını yansıtan bir alıntı buraya eklenecektir.]
      </Quote>
    </Container>
  </Section>
</Layout>
