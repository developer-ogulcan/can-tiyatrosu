---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import PerdeMark from '../components/PerdeMark.astro';

let pressItems = [];
try {
  const pressCollection = await getCollection('press');
  pressItems = (pressCollection || []).sort((a, b) => 
    new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
  );
} catch (e) {
  pressItems = [];
}
---

<Layout 
  title="Basında Biz - Çan Tiyatrosu" 
  description="Çan Tiyatrosu hakkında basında çıkan haberler, gazete küpürleri, röportajlar ve değerlendirmeler."
>
  <!-- Hero / Header Area -->
  <section class="pt-32 pb-14 bg-paper border-b border-hairline">
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Yazılı ve Görsel Basın</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-display text-ink mb-4 leading-tight">
          Basında Biz
        </h1>
        <p class="text-base sm:text-lg text-stone leading-relaxed">
          1984'ten günümüze Çan Tiyatrosu, oyunlarımız, oyuncularımız ve tiyatro kültürüne katkılarımız hakkında ulusal ve yerel basında yer alan haberler.
        </p>
      </div>
    </Container>
  </section>

  <!-- Content Section -->
  <Section tone="paper">
    <Container>
      {pressItems.length === 0 ? (
        <div class="max-w-xl mx-auto my-8 p-10 text-center bg-paper-dim border border-hairline rounded-xl shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 text-gold flex items-center justify-center rounded-full bg-paper border border-hairline">
            📰
          </div>
          <h2 class="text-xl font-display text-ink mb-2">Henüz İçerik Eklenmedi</h2>
          <p class="text-sm text-stone leading-relaxed">
            Basın haberleri TinaCMS paneli üzerinden eklendikçe bu alanda gazete küpürleri ve haber bağlantıları listelenecektir.
          </p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {pressItems.map((item) => {
            const { title, sourceName, publishDate, coverImage, summary, externalUrl } = item.data;
            const dateStr = new Date(publishDate).toLocaleDateString('tr-TR', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });

            return (
              <article class="flex flex-col bg-paper border border-hairline rounded-lg overflow-hidden shadow-card hover:border-curtain/50 transition-all duration-300 group">
                {coverImage && (
                  <div class="aspect-video w-full overflow-hidden bg-paper-dim relative border-b border-hairline">
                    <img 
                      src={coverImage} 
                      alt={title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                    {sourceName && (
                      <span class="absolute top-3 left-3 bg-curtain text-paper text-[11px] font-bold px-2.5 py-1 rounded shadow-sm uppercase tracking-wider">
                        {sourceName}
                      </span>
                    )}
                  </div>
                )}

                <div class="flex flex-1 flex-col justify-between p-6">
                  <div class="mb-6">
                    <time class="text-xs font-bold text-stone mb-2 block uppercase tracking-wider">
                      {dateStr}
                    </time>
                    <h2 class="text-xl font-display text-ink group-hover:text-curtain transition-colors mb-3 leading-snug">
                      {title}
                    </h2>
                    {summary && (
                      <p class="text-sm text-stone leading-relaxed line-clamp-3">
                        {summary}
                      </p>
                    )}
                  </div>

                  {externalUrl && (
                    <div class="pt-4 border-t border-hairline mt-auto">
                      <a 
                        href={externalUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="btn-secondary !w-full !py-2 !text-xs !justify-between"
                      >
                        <span>Haberin Detayları</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )}
    </Container>
  </Section>

  <PerdeMark align="center" class="!py-6" />
</Layout>