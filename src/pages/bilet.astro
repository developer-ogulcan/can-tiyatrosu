---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import FormField from '../components/FormField.astro';
import Button from '../components/Button.astro';

// TinaCMS content/tickets koleksiyonunu çekiyoruz
let tickets = [];
try {
  const ticketCollection = await getCollection('tickets');
  tickets = ticketCollection.map((entry) => entry.data);
} catch (e) {
  tickets = [];
}
---

<Layout 
  title="Bilet Al | Çan Tiyatrosu Sahne Etkinlikleri" 
  description="Çan Tiyatrosu repertuvarındaki oyunlar, çocuk tiyatroları ve gösterimler için online bilet satın alın, toplu bilet talebi oluşturun."
>
  <PageHero
    eyebrow="GÖSTERİM TAKVİMİ & BİLET"
    title="Sahneye Davetlisiniz"
    lede="Repertuvarımızdaki yetişkin ve çocuk oyunları için dilediğiniz platformdan biletinizi alın veya toplu gösterim avantajlarından yararlanın."
  />

  <Section tone="paper">
    <Container>
      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-hairline pb-6">
        <div>
          <span class="eyebrow !text-curtain mb-2 block">Satıştaki Etkinlikler</span>
          <h2 class="text-3xl md:text-4xl font-display">Güncel Oyun & Gösterim Takvimi</h2>
        </div>
        <p class="text-stone text-sm max-w-md">
          Biletlerinizi aşağıdaki anlaşmalı satış platformlarından güvenle temin edebilirsiniz.
        </p>
      </div>

      {tickets.length > 0 ? (
        <div class="grid gap-10">
          {tickets.map((item) => {
            const dateObj = item.eventDate ? new Date(item.eventDate) : null;
            const formattedDate = dateObj 
              ? dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', weekday: 'long' })
              : 'Tarih Belirtilmedi';
            const formattedTime = dateObj 
              ? dateObj.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })
              : '';

            return (
              <div class="rounded-2xl border border-hairline bg-paper shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden grid md:grid-cols-12 gap-0">
                {/* Sol: Afiş / Görsel */}
                <div class="md:col-span-4 relative bg-ink min-h-[260px] md:min-h-full overflow-hidden flex items-center justify-center">
                  {item.coverImage ? (
                    <img src={item.coverImage} alt={item.title} class="w-full h-full object-cover" />
                  ) : (
                    <div class="p-8 text-center">
                      <span class="text-paper/40 text-xs font-mono uppercase tracking-widest block border border-paper/20 rounded px-3 py-1">
                        Çan Tiyatrosu
                      </span>
                    </div>
                  )}
                  {item.category && (
                    <span class="absolute top-4 left-4 bg-curtain text-paper text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                      {item.category}
                    </span>
                  )}
                </div>

                {/* Sağ: İçerik */}
                <div class="md:col-span-8 p-6 md:p-8 flex flex-col justify-between">
                  <div>
                    {/* Tarih ve Tür Bilgisi (Vektör Takvim İkonu İle) */}
                    <div class="flex flex-wrap items-center gap-2 text-sm text-curtain font-semibold mb-3">
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>{formattedDate} {formattedTime && `• ${formattedTime}`}</span>
                      {item.genre && <span class="text-stone/50 font-normal">| {item.genre}</span>}
                    </div>

                    <h3 class="text-2xl md:text-3xl font-bold text-ink mb-3">{item.title}</h3>

                    {/* Mekân Bilgisi (Vektör Konum İkonu İle) */}
                    <div class="flex items-center gap-2 text-stone text-sm mb-4 bg-dim p-3 rounded-lg border border-hairline/50">
                      <svg class="w-4 h-4 text-curtain shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span class="font-bold text-ink">Mekân:</span>
                      <span>{item.venue || 'Çan Tiyatrosu Ana Sahne'}</span>
                      {item.locationText && <span class="text-stone/60">({item.locationText})</span>}
                    </div>

                    {/* Kadro & Künye */}
                    {(item.creatives || item.cast) && (
                      <div class="text-xs text-stone/80 space-y-1 mb-6 border-l-2 border-curtain/40 pl-3">
                        {item.creatives && <p><strong class="text-ink">Künye:</strong> {item.creatives}</p>}
                        {item.cast && <p><strong class="text-ink">Oyuncular:</strong> {item.cast}</p>}
                      </div>
                    )}
                  </div>

                  {/* Bilet Butonları */}
                  <div class="pt-4 border-t border-hairline">
                    <p class="text-xs uppercase tracking-widest font-bold text-stone mb-3">Bilet Satış Platformları</p>
                    <div class="flex flex-wrap items-center gap-3">
                      {item.ticketLinks && item.ticketLinks.length > 0 ? (
                        item.ticketLinks.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            style={{
                              backgroundColor: link.bgColor || '#991b1b',
                              color: link.textColor || '#ffffff',
                            }}
                            class="px-5 py-2.5 rounded-lg font-bold text-sm shadow-sm hover:opacity-95 hover:scale-[1.02] transition-all flex items-center gap-2"
                          >
                            <span>{link.platformName || 'Bilet Al'}</span>
                            <svg class="w-3.5 h-3.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                          </a>
                        ))
                      ) : (
                        <a href="/iletisim" class="btn-primary !py-2 !text-xs">Gişe / Rezerve Et</a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        /* Etkinlik Yoksa Minimalist Boş Durum Görünümü */
        <div class="rounded-2xl border border-hairline bg-dim p-8 md:p-12 text-center max-w-2xl mx-auto">
          <h3 class="text-2xl font-bold mb-2">Yakında Yeni Sezon Biletleri Satışta</h3>
          <p class="text-stone leading-relaxed mb-6">
            Şu an aktif online satışta olan oyunumuz bulunmamaktadır. Sezon programı, özel davetiyeler ve bilet rezervasyonları için doğrudan gişemizle iletişime geçebilirsiniz.
          </p>
          <a href="/iletisim" class="btn-primary">Gişe İle İletişime Geç</a>
        </div>
      )}
    </Container>
  </Section>

  <!-- Toplu Bilet Formu -->
  <Section tone="dim">
    <Container narrow>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="eyebrow !text-curtain mb-2 block">Özel Avantajlar</span>
        <h2 class="text-3xl md:text-4xl font-display mb-4">Toplu Bilet & Kampanyalı Alım Talebi</h2>
        <p class="text-stone text-base leading-relaxed">
          Okul grupları, şirketler, toplu organizasyonlar ve hediye edilmek istenen açık biletler için özel indirim oranlarımızdan yararlanmak üzere aşağıdaki formu doldurabilirsiniz.
        </p>
      </div>

      <div class="bg-paper p-8 md:p-10 rounded-2xl border border-hairline shadow-lg">
        <form id="bilet-talep-form" class="grid gap-6">
          <div class="grid md:grid-cols-2 gap-6">
            <FormField label="Adınız Soyadınız" name="name" required />
            <FormField label="Kurum / Okul / Grup Adı" name="organization" placeholder="Örn: X Koleji, Y A.Ş. veya Bireysel" />
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <FormField label="E-posta" name="email" type="email" required />
            <FormField label="Telefon" name="phone" type="tel" required />
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <FormField 
              label="Bilet / Talep Türü" 
              name="ticket_type" 
              type="select" 
              required 
              options={[
                'Toplu Bilet Satışı (Okul / Şirket / Grup)',
                'Açık Bilet (Hediye Bilet)',
                'Kampanyalı / İndirimli Bilet Talebi',
                'Özel Gösterim / Salon Kiralama'
              ]} 
            />
            <FormField label="Tahmini Kişi / Bilet Sayısı" name="ticket_count" placeholder="Örn: 45 kişi" required />
          </div>

          <FormField label="İlgilendiğiniz Oyun veya Tarih Aralığı" name="preferred_event" placeholder="Örn: Çirkin Prens - Ekim Ayı Seansları" />

          <FormField label="Eklemek İstediğiniz Notlar" name="notes" type="textarea" rows={3} placeholder="Varsa seans tercihi, özel istekleriniz..." />

          <div>
            <Button type="submit" variant="primary" class="w-full justify-center text-center">
              Toplu Bilet Talebini Gönder
            </Button>
          </div>
        </form>
      </div>
    </Container>
  </Section>
</Layout>

<script>
  const form = document.getElementById('bilet-talep-form') as HTMLFormElement;
  const GOOGLE_SCRIPT_URL = 'GOOGLE_APPS_SCRIPT_WEB_APP_URL_BURAYA';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerText = 'Talebiniz Gönderiliyor...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    data.form_type = 'toplu_bilet';

    try {
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data),
      });

      alert('Toplu bilet talebiniz başarıyla alındı! İndirimli teklifimizle birlikte en kısa sürede sizinle iletişime geçeceğiz.');
      form.reset();
    } catch (err) {
      console.error(err);
      alert('Bir hata oluştu, lütfen doğrudan gişe/iletişim sayfamızdan bizimle bağlantıya geçiniz.');
    } finally {
      btn.disabled = false;
      btn.innerText = originalText;
    }
  });
</script>