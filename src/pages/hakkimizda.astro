---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import PerdeMark from '../components/PerdeMark.astro';
import CTA from '../components/CTA.astro';

const aboutCollection = await getCollection('about');
const aboutEntry =
  aboutCollection.find((entry) => entry.id === 'about.md' || entry.id === 'about' || entry.slug === 'about') ??
  aboutCollection[0];

if (!aboutEntry) {
  throw new Error('About page content not found');
}
const about = aboutEntry.data;

// Metinlerdeki satır başlarını gerçek paragraflara dönüştüren yardımcı fonksiyon
function renderParagraphs(text: string) {
  if (!text) return null;
  return text
    .split(/\n\s*\n/) // Çift satır başlarını (paragrafları) ayırır
    .filter((p) => p.trim().length > 0)
    .map((paragraph) => paragraph.replace(/\n/g, ' ')); // Tekil satır kırılmalarını boşluğa çevirir
}
---

<Layout title="Hakkımızda" description="Çan Tiyatrosu'nun tarihi, misyonu, vizyonu ve değerleri.">
  <PageHero
    eyebrow={about.eyebrow}
    title={about.title}
    lede={about.lede}
    eyebrowField={tinaField(about, 'eyebrow')}
    titleField={tinaField(about, 'title')}
    ledeField={tinaField(about, 'lede')}
  />

  <!-- MİSYON BÖLÜMÜ -->
  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-12 gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-5">Misyon</p>
          <h2 class="text-3xl mb-4" data-tina-field={tinaField(about, 'missionTitle')}>
            {about.missionTitle}
          </h2>
        </div>
        <div class="md:col-span-8 prose-editorial text-lg text-stone leading-relaxed space-y-6" data-tina-field={tinaField(about, 'missionBody')}>
          {renderParagraphs(about.missionBody)?.map((pText) => (
            <p>{pText}</p>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <PerdeMark align="center" class="!py-2" />

  <!-- VİZYON BÖLÜMÜ -->
  <Section tone="paper" spacing="tight">
    <Container>
      <div class="grid md:grid-cols-12 gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-5">Vizyon</p>
          <h2 class="text-3xl mb-4" data-tina-field={tinaField(about, 'visionTitle')}>
            {about.visionTitle}
          </h2>
        </div>
        <div class="md:col-span-8 prose-editorial text-lg text-stone leading-relaxed space-y-6" data-tina-field={tinaField(about, 'visionBody')}>
          {renderParagraphs(about.visionBody)?.map((pText) => (
            <p>{pText}</p>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="dim">
    <Container>
      <p class="eyebrow mb-5">Değerlerimiz</p>
      <div class="grid md:grid-cols-4 gap-8 mt-10" data-tina-field={tinaField(about, 'values')}>
        {about.values.map((v) => (
          <div class="border-t-2 border-gold-deep pt-5">
            <h3 class="text-xl mb-2">{v.title}</h3>
            <p class="text-stone leading-relaxed">{v.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Tarihçe</p>
      <h2 class="text-4xl md:text-5xl mb-14 max-w-2xl">Sahneler değişti, disiplin hiç değişmedi</h2>
      <div data-tina-field={tinaField(about, 'timeline')}>
        <Timeline entries={about.timeline} />
      </div>
    </Container>
  </Section>

  <Section tone="ink" spacing="tight">
    <Container>
      <p class="eyebrow !text-gold-bright mb-5">Kazanımlar ve Ödüller</p>

      {about.awards && about.awards.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-6 pt-6 border-t border-paper/10" data-tina-field={tinaField(about, 'awards')}>
          {about.awards.map((award) => (
            <div class="bg-paper/5 p-6 rounded-xl border border-paper/10">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xl font-semibold text-paper">{award.title}</h3>
                {award.year && <span class="text-sm text-gold-bright font-mono">{award.year}</span>}
              </div>
              {award.description && (
                <p class="text-paper/70 text-sm leading-relaxed">{award.description}</p>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-4 max-w-2xl text-paper/60 leading-relaxed">
          Henüz ödül verisi eklenmedi. TinaCMS panelinden "Ödüller ve Başarılar" kısmından ekleyebilirsiniz.
        </p>
      )}
    </Container>
  </Section>

  <CTA
    title="Kurucularımızı ve mirasımızı tanıyın"
    description="İki kurucu isim ve onların bıraktığı sahne kültürü hakkında daha fazla bilgi edinin."
    primaryLabel="Kurucular Sayfasına Git"
    primaryHref="/kurucular"
    secondaryLabel="Basın Kitini İndirin"
    secondaryHref="/basin/basin-kiti"
  />
</Layout>