---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mobil Uygulama" description="Çan Tiyatrosu mobil uygulamasını telefonunuza indirin ve etkinlikleri anında takip edin.">
  <section class="py-16 container-editorial max-w-2xl mx-auto text-center">
    <div class="mb-6 flex justify-center">
      <img src="/images/logo.png" alt="Çan Tiyatrosu Logo" class="h-24 w-auto" />
    </div>

    <h1 class="text-3xl font-bold text-ink mb-4">Çan Tiyatrosu Mobil Uygulaması</h1>
    <p class="text-stone mb-8 leading-relaxed">
      Sahnemize ve biletlerimize tek tıkla ulaşın! Uygulamamızı cihazınızın ana ekranına ekleyerek gösterim takvimini kolayca takip edebilirsiniz.
    </p>

    <!-- Yükle Butonu (Android / Destekleyen Tarayıcılar) -->
    <div class="bg-paper-dim p-6 rounded-xl border border-hairline mb-8 shadow-sm">
      <button 
        id="pwa-install-btn" 
        class="hidden w-full btn-primary !py-3.5 !text-base font-bold shadow-md"
      >
        📲 Uygulamayı Yüklü Olarak Ekle
      </button>

      <!-- iOS / Safari Rehberi -->
      <div id="ios-instructions" class="text-left text-sm text-ink/90 space-y-3">
        <p class="font-bold text-curtain border-b border-hairline pb-2">iPhone / Safari Kullanıcıları İçin Yükleme:</p>
        <ol class="list-decimal list-inside space-y-1.5 text-stone">
          <li>Tarayıcının en altındaki <strong>Paylaş (Share)</strong> simgesine dokunun.</li>
          <li>Açılan menüde aşağı kaydırıp <strong>"Ana Ekrana Ekle"</strong> seçeneğini seçin.</li>
          <li>Sağ üstteki <strong>"Ekle"</strong> butonuna basarak tamamlayın.</li>
        </ol>
      </div>
    </div>
  </section>
</Layout>

<script>
  let deferredPrompt: any;
  const installBtn = document.getElementById('pwa-install-btn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (installBtn) {
      installBtn.classList.remove('hidden');
    }
  });

  installBtn?.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') {
      installBtn.classList.add('hidden');
    }
    deferredPrompt = null;
  });
</script>