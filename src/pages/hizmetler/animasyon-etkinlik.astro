---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Gallery from '../../components/Gallery.astro';
import Accordion from '../../components/Accordion.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';

const benefits = [
  { title: 'Etkinliğe Özel Program', description: 'Kurumunuzun etkinlik amacına göre tasarlanan animasyon ve performans programı.' },
  { title: 'Deneyimli Ekip', description: 'Sahne deneyimi olan profesyonel oyuncu ve animatörlerle çalışırsınız.' },
  { title: 'Esnek Format', description: 'Kısa sahne gösterimlerinden tam gün etkinlik programlarına kadar esnek planlama.' },
];

const faq = [
  { question: 'Hangi tür etkinliklere uygun bir hizmet?', answer: '[Yanıt buraya eklenecektir.]' },
  { question: 'Açık hava etkinliklerinde hizmet veriyor musunuz?', answer: '[Yanıt buraya eklenecektir.]' },
  { question: 'Programı özel olarak tasarlatabilir miyiz?', answer: '[Yanıt buraya eklenecektir.]' },
];
---

<Layout title="Animasyon ve Etkinlik" description="Kurumsal ve özel etkinlikler için yaratıcı animasyon ve sahne performansları.">
  <PageHero
    eyebrow="Hizmet"
    title="Animasyon ve Etkinlik"
    lede="Kurumsal etkinlikleriniz, açılışlarınız ve özel günleriniz için yaratıcı animasyon programları ve sahne performansları tasarlıyoruz."
  />

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Neden Bizimle Çalışmalısınız</p>
      <div class="grid md:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="border-t-2 border-gold-deep pt-5">
            <h3 class="text-xl mb-2">{b.title}</h3>
            <p class="text-stone leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="dim" spacing="tight">
    <Container>
      <Gallery count={6} caption="Etkinlik animasyonu" />
    </Container>
  </Section>

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Sıkça Sorulan Sorular</p>
      <Accordion items={faq} />
    </Container>
  </Section>

  <Section tone="dim">
    <Container narrow>
      <p class="eyebrow mb-5">Talep Formu</p>
      <h2 class="text-3xl md:text-4xl mb-8">Etkinliğiniz için teklif isteyin</h2>
      <form class="grid gap-6" method="post" action="#">
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Kurum / Kişi Adı" name="ad" required />
          <FormField label="Etkinlik Türü" name="etkinlik-turu" />
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="E-posta" name="email" type="email" required />
          <FormField label="Telefon" name="telefon" type="tel" required />
        </div>
        <FormField label="Etkinlik Tarihi" name="tarih" type="date" />
        <FormField label="Notlarınız" name="mesaj" type="textarea" placeholder="Etkinlik yeri, süresi ve beklentileriniz" />
        <div>
          <Button type="submit" variant="primary">Teklif İste</Button>
        </div>
      </form>
    </Container>
  </Section>
</Layout>
