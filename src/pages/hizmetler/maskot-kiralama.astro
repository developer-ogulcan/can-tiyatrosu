---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Gallery from '../../components/Gallery.astro';
import Accordion from '../../components/Accordion.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';

const benefits = [
  { title: 'Profesyonel Performans', description: 'Maskot performansı, sahne deneyimi olan eğitimli oyuncular tarafından yapılır.' },
  { title: 'Bakımlı Kostüm Envanteri', description: 'Düzenli bakımı yapılan, hijyenik ve özenle saklanan maskot kostümleri kullanılır.' },
  { title: 'Kurumunuza Özel Karakter', description: 'Talep halinde kurumunuza özel maskot karakteri tasarımı sunulur.' },
];

const faq = [
  { question: 'Hangi maskot karakterleri mevcut?', answer: '[Yanıt buraya eklenecektir.]' },
  { question: 'Kiralama süresi ne kadar?', answer: '[Yanıt buraya eklenecektir.]' },
  { question: 'Kurumumuza özel karakter tasarlatabilir miyiz?', answer: '[Yanıt buraya eklenecektir.]' },
];
---

<Layout title="Maskot Kiralama" description="Kurumsal ve özel etkinlikler için profesyonel maskot performansı ve kiralama hizmeti.">
  <PageHero
    eyebrow="Hizmet"
    title="Maskot Kiralama"
    lede="Etkinlikleriniz için profesyonel maskot performansı sunuyor, talebe göre kurumunuza özel karakter tasarımı gerçekleştiriyoruz."
  />

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Neden Bizimle Çalışmalısınız</p>
      <div class="grid md:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="border-t-2 border-gold-deep pt-5">
            <h3 class="text-xl mb-2">{b.title}</h3>
            <p class="text-stone leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="dim" spacing="tight">
    <Container>
      <Gallery count={6} caption="Maskot performansı" />
    </Container>
  </Section>

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Sıkça Sorulan Sorular</p>
      <Accordion items={faq} />
    </Container>
  </Section>

  <Section tone="dim">
    <Container narrow>
      <p class="eyebrow mb-5">Talep Formu</p>
      <h2 class="text-3xl md:text-4xl mb-8">Maskot kiralama talebinizi iletin</h2>
      <form class="grid gap-6" method="post" action="#">
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Kurum / Kişi Adı" name="ad" required />
          <FormField label="İstenen Karakter" name="karakter" />
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="E-posta" name="email" type="email" required />
          <FormField label="Telefon" name="telefon" type="tel" required />
        </div>
        <FormField label="Etkinlik Tarihi" name="tarih" type="date" />
        <FormField label="Notlarınız" name="mesaj" type="textarea" />
        <div>
          <Button type="submit" variant="primary">Talebi Gönder</Button>
        </div>
      </form>
    </Container>
  </Section>
</Layout>
