---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import CTA from '../../components/CTA.astro';

const services = [
  {
    title: 'Kurumsal Gösterimler',
    href: '/hizmetler/kurumsal-gosterimler',
    description: 'Okullar, belediyeler ve kurumlar için özel olarak planlanan, repertuvarımızdan seçilen sahne gösterimleri.',
  },
  {
    title: 'Animasyon ve Etkinlik',
    href: '/hizmetler/animasyon-etkinlik',
    description: 'Kurumsal ve özel etkinliklere yönelik yaratıcı animasyon programları, atölyeler ve sahne performansları.',
  },
  {
    title: 'Maskot Kiralama',
    href: '/hizmetler/maskot-kiralama',
    description: 'Etkinlikleriniz için profesyonel maskot performansı, karakter tasarımı ve kiralama hizmeti.',
  },
];
---

<Layout title="Hizmetler" description="Çan Tiyatrosu'nun kurumsal gösterim, animasyon ve maskot kiralama hizmetleri.">
  <PageHero
    eyebrow="Sahnenin Ötesinde"
    title="Hizmetlerimiz"
    lede="Sahne üretiminin yanı sıra, kurumlar ve etkinlikler için geliştirdiğimiz profesyonel hizmetler."
  />

  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-3 gap-6">
        {services.map((s) => (
          <Card href={s.href}>
            <h2 class="text-2xl mb-3 group-hover:text-curtain transition-colors">{s.title}</h2>
            <p class="text-stone leading-relaxed mb-6">{s.description}</p>
            <span class="text-sm font-semibold text-curtain">Detayları gör →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <CTA
    title="Kurumunuza uygun hizmeti birlikte belirleyelim"
    description="İhtiyacınıza en uygun hizmeti seçmek için bizimle iletişime geçin."
    primaryLabel="İletişime Geçin"
    primaryHref="/iletisim"
    secondaryLabel="Kurumsal Gösterim Talebi"
    secondaryHref="/basvurular/kurumsal-gosterim-talebi"
  />
</Layout>
