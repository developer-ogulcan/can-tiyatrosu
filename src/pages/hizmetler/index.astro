---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import CTA from '../../components/CTA.astro';

const servicesCollection = await getCollection('services');
const servicesEntry =
  servicesCollection.find((entry) => entry.id === 'services.md' || entry.id === 'services' || entry.slug === 'services') ??
  servicesCollection[0];
if (!servicesEntry) {
  throw new Error('Services page content not found');
}
const servicesData = servicesEntry.data;
---

<Layout title="Hizmetler" description="Çan Tiyatrosu'nun kurumsal gösterim, animasyon ve maskot kiralama hizmetleri.">
  <PageHero
    eyebrow={servicesData.eyebrow}
    title={servicesData.title}
    lede={servicesData.lede}
    eyebrowField={tinaField(servicesData, 'eyebrow')}
    titleField={tinaField(servicesData, 'title')}
    ledeField={tinaField(servicesData, 'lede')}
  />

  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-3 gap-6" data-tina-field={tinaField(servicesData, 'services')}>
        {servicesData.services.map((service) => (
          <Card href={`/hizmetler/${service.title.toLowerCase().replaceAll(' ', '-').replace(/[^a-z0-9-çğıöşü]/gi, '')}`}>
            <h2 class="text-2xl mb-3 group-hover:text-curtain transition-colors">{service.title}</h2>
            <p class="text-stone leading-relaxed mb-6">{service.description}</p>
            <span class="text-sm font-semibold text-curtain">Detayları gör →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <CTA
    title="Kurumunuza uygun hizmeti birlikte belirleyelim"
    description={servicesData.description}
    primaryLabel="İletişime Geçin"
    primaryHref="/iletisim"
    secondaryLabel="Kurumsal Gösterim Talebi"
    secondaryHref="/basvurular/kurumsal-gosterim-talebi"
  />
</Layout>
