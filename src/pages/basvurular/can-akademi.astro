---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import Statistic from '../../components/Statistic.astro';
---

<Layout title="Çan Akademi" description="Çocuklar ve gençler için oyunculuk ve sahne sanatları eğitim programı başvurusu.">
  <PageHero
    eyebrow="Eğitim"
    title="Çan Akademi"
    lede="Çocuklar ve gençler için tasarlanan oyunculuk ve sahne sanatları eğitim programımıza başvurun."
  />

  <Section tone="dim" spacing="tight">
    <Container>
      <div class="grid md:grid-cols-3 gap-8">
        <Statistic value="[X]" label="Yaş Grubu Programı" />
        <Statistic value="[X]" label="Haftalık Ders Saati" />
        <Statistic value="[X]" label="Dönem Süresi (Hafta)" />
      </div>
      <p class="mt-8 max-w-2xl text-stone leading-relaxed">
        [Çan Akademi programının içeriği, eğitim yaklaşımı ve kadrosu hakkında detaylı açıklama buraya eklenecektir.]
      </p>
    </Container>
  </Section>

  <Section tone="paper">
    <Container narrow>
      <h2 class="text-2xl mb-8">Başvuru Formu</h2>
      <form class="grid gap-6" method="post" action="#">
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Öğrenci Adı Soyadı" name="ogrenci-adi" required />
          <FormField label="Doğum Tarihi" name="dogum-tarihi" type="date" required />
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Veli Adı Soyadı" name="veli-adi" required />
          <FormField label="Veli Telefonu" name="veli-telefon" type="tel" required />
        </div>
        <FormField label="E-posta" name="email" type="email" required />
        <FormField label="İlgi Alanları / Deneyim" name="deneyim" type="textarea" placeholder="Varsa sahne, dans veya müzik deneyimi" />
        <div>
          <Button type="submit" variant="primary">Başvuruyu Gönder</Button>
        </div>
      </form>
    </Container>
  </Section>
</Layout>
