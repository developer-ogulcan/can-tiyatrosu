---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
---

<Layout title="Oyunculuk Başvurusu" description="Çan Tiyatrosu kadrosuna katılmak isteyen oyuncu adayları için başvuru formu.">
  <PageHero
    eyebrow="Kadro"
    title="Oyunculuk Başvurusu"
    lede="Kadromuza katılmak isteyen oyuncu adaylarının başvurularını bu form aracılığıyla kabul ediyoruz. Uygun pozisyon açıldığında sizinle iletişime geçilecektir."
  />

  <Section tone="paper">
    <Container narrow>
      <form class="grid gap-6" method="post" action="#" enctype="multipart/form-data">
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Adı Soyadı" name="ad-soyad" required />
          <FormField label="Doğum Tarihi" name="dogum-tarihi" type="date" />
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="E-posta" name="email" type="email" required />
          <FormField label="Telefon" name="telefon" type="tel" required />
        </div>
        <FormField
          label="Eğitim Durumu"
          name="egitim"
          type="select"
          options={['Konservatuvar Mezunu', 'Tiyatro / Sahne Sanatları Bölümü Mezunu', 'İlgili Eğitim Almış', 'Diğer']}
        />
        <FormField label="Sahne Deneyimi" name="deneyim" type="textarea" placeholder="Rol aldığınız yapımlar ve deneyiminiz" />
        <div class="flex flex-col gap-2">
          <label for="field-cv" class="text-sm font-semibold text-ink">Özgeçmiş / Demo Reel (PDF veya bağlantı)</label>
          <input id="field-cv" name="cv" type="file" class="text-sm text-stone file:mr-4 file:rounded-[2px] file:border-0 file:bg-ink file:text-paper file:px-4 file:py-2.5 file:text-sm file:font-semibold" />
        </div>
        <div>
          <Button type="submit" variant="primary">Başvuruyu Gönder</Button>
        </div>
      </form>
    </Container>
  </Section>
</Layout>
