---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';

const items = [
  {
    title: 'Ekip Başvurusu',
    href: '/basvurular/ekip-basvurusu',
    description: 'Tiyatro bünyesinde oyuncu, yönetmen, yazar, teknik ekip veya başka bir alanda görev almak isteyenler.',
  },
  {
    title: 'Çan Akademi Başvurusu',
    href: '/basvurular/can-akademi-basvurusu',
    description: 'Ana ekibe dahil olmadan hobi olarak tiyatro yapmak isteyen yetişkinler için özgür üretim alanı.',
  },
  {
    title: 'Kurumsal Gösterim Talebi',
    href: '/basvurular/kurumsal-gosterim-talebi',
    description: 'Okul, belediye veya kurumunuz için sahne gösterimi planlamak üzere talep oluşturun.',
  },
];
---

<Layout title="Katıl" description="Ekip başvurusu, Çan Akademi ve kurumsal gösterim talepleri.">
  <PageHero
    eyebrow="Katıl"
    title="Başvurular"
    lede="Ekibe katılmak, Çan Akademi'de üretmek veya kurumunuz için gösterim talep etmek — size uygun formu seçin."
  />

  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-3 gap-6">
        {items.map((item) => (
          <Card href={item.href}>
            <h2 class="text-2xl mb-3 group-hover:text-curtain transition-colors">{item.title}</h2>
            <p class="text-stone leading-relaxed mb-6">{item.description}</p>
            <span class="text-sm font-bold text-curtain">Başvuru formuna git →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>
</Layout>
