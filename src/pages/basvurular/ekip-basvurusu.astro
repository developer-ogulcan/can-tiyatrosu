---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
---

<Layout title="Ekip Başvurusu" description="Çan Tiyatrosu bünyesinde görev almak isteyen adaylar için ekip başvuru formu.">
  <PageHero
    eyebrow="Katıl"
    title="Ekip Başvurusu"
    lede="Tiyatro bünyesinde görev almak istediğiniz alanı belirtin — oyuncu, yönetmen, yazar, teknik ekip ve daha fazlası. Cast ajansı değiliz; bir tiyatro topluluğu arıyoruz."
  />

  <Section tone="paper">
    <Container narrow>
      <form id="ekip-form" class="grid gap-6">
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="Adı Soyadı" name="name" required />
          <FormField label="Doğum Tarihi" name="birth_date" type="date" />
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <FormField label="E-posta" name="email" type="email" required />
          <FormField label="Telefon" name="phone" type="tel" required />
        </div>
        <FormField
          label="Görev Almak İstediğiniz Alan"
          name="role_area"
          type="select"
          required
          options={[
            'Oyuncu',
            'Yönetmen',
            'Yazar / Dramaturg',
            'Sahne Tasarım',
            'Kostüm',
            'Işık / Ses Teknik',
            'Reji Asistanı',
            'Prodüksiyon / Organizasyon',
            'Diğer',
          ]}
        />
        <FormField
          label="Eğitim Durumu"
          name="education"
          type="select"
          options={[
            'Konservatuvar Mezunu',
            'Tiyatro / Sahne Sanatları Bölümü Mezunu',
            'İlgili Eğitim Almış',
            'Deneyimle Öğrenmiş',
            'Diğer',
          ]}
        />
        <FormField
          label="Deneyim ve Neden Katılmak İstiyorsunuz?"
          name="experience"
          type="textarea"
          placeholder="Sahne deneyiminiz, ilgi alanlarınız, portfolyo/CV bağlantınız ve Çan Tiyatrosu'nda görev almak isteme nedeniniz"
        />
        <div>
          <Button type="submit" variant="primary">Başvuruyu Gönder</Button>
        </div>
      </form>
    </Container>
  </Section>
</Layout>

<script>
  const form = document.getElementById('ekip-form') as HTMLFormElement;
  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyBGaSAsdhoxTZ4cU-dUgsQTbcYdSTrzfcYktLKoCbVXLDh3r8zRrOkKWWA3ss13L7i1Q/exec';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerText = 'Gönderiliyor...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    data.form_type = 'ekip';

    try {
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data),
      });

      alert('Ekip başvurunuz başarıyla alındı! Değerlendirme sonrası sizinle iletişime geçeceğiz.');
      form.reset();
    } catch (err) {
      console.error(err);
      alert('Bir hata oluştu, lütfen daha sonra tekrar deneyiniz.');
    } finally {
      btn.disabled = false;
      btn.innerText = originalText;
    }
  });
</script>