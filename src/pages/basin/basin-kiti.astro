---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';

const downloads = [
  { 
    title: 'Logo Paketi (PNG / SVG / Vector)', 
    description: 'Açık ve koyu zemin üzerinde kullanım için yüksek çözünürlüklü logo varyasyonları.',
    fileUrl: '/press/Can_Tiyatrosu_Logo_Paketi.zip',
    fileName: 'Can_Tiyatrosu_Logo_Paketi.zip'
  },
  { 
    title: 'Basın Kiti & Tanıtım Metinleri', 
    description: 'Kurum hakkında detaylı bilgi, vizyon, sahne detayları ve resmi basın bülteni.',
    fileUrl: '/press/Can_Tiyatrosu_Basin_Kiti.docx',
    fileName: 'Can_Tiyatrosu_Basin_Kiti.docx'
  },
  { 
    title: 'Marka Kullanım Kılavuzu', 
    description: 'Renk paleti, tipografi, logo kullanım kuralları ve kurumsal kimlik detayları.',
    fileUrl: '/press/Can_Tiyatrosu_Marka_Kilavuzu.docx',
    fileName: 'Can_Tiyatrosu_Marka_Kilavuzu.docx'
  },
];
---

<Layout title="Basın Kiti" description="Çan Tiyatrosu logo, marka varlıkları ve basın için indirilebilir materyaller.">
  <PageHero
    eyebrow="Basın"
    title="Basın Kiti"
    lede="Gazeteciler ve kurumsal iş birlikleri için Çan Tiyatrosu'na ait logo, fotoğraf ve tanıtım materyalleri."
  />

  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-2 gap-6">
        {downloads.map((d) => (
          <Card>
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl mb-2">{d.title}</h2>
                <p class="text-stone leading-relaxed">{d.description}</p>
              </div>
              
             <a
  href={d.fileUrl}
  download
  target="_blank"
  type={d.fileUrl.endsWith('.zip') ? 'application/zip' : undefined}
  class="shrink-0 text-xs uppercase font-bold tracking-wide text-curtain border border-curtain rounded-full px-4 py-1.5 hover:bg-curtain hover:text-paper transition-colors"
>
  İndir
</a>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="dim" spacing="tight">
    <Container>
      <p class="eyebrow mb-5">Kurumsal Tanıtım Metni</p>
      <div class="max-w-3xl text-lg text-stone leading-relaxed space-y-4">
        <blockquote class="border-l-4 border-curtain pl-4 italic text-ink">
          "Çan Tiyatrosu; Ankara'da köklü tiyatro geleneklerini genç ve yenilikçi bir vizyonla buluşturan, özgür sahne üretimine ve topluluk ruhuna odaklanan bağımsız bir tiyatro alanıdır."
        </blockquote>
        <p>
          Oyunculuk, reji, tiyatro yazarlığı ve çocuk atölyeleri alanında aktif üretimlerine devam eden tiyatro; hem kendi ana prodüksiyonlarını seyirciyle buluşturmakta hem de Çan Akademi çatısı altında bağımsız projeler üreten sanatçılara sahne ve teknik imkan sunmaktadır.
        </p>
      </div>
    </Container>
  </Section>

  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Basın İletişimi</p>
      <p class="max-w-xl text-stone leading-relaxed">
        Röportaj, fotoğraf ve basın talepleri için doğrudan bizimle iletişime geçebilirsiniz.
      </p>
      <a href="/iletisim" class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-curtain hover:underline underline-offset-4">
        İletişim bilgilerini görün →
      </a>
    </Container>
  </Section>
</Layout>