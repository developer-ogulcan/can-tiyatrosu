---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import AnnouncementCard from '../../components/AnnouncementCard.astro';

const announcements = (await getCollection('announcements'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Haberler ve Duyurular | Çan Tiyatrosu" description="Çan Tiyatrosu'ndan güncel haberler, duyurular ve etkinlikler.">
  <PageHero
    eyebrow="Güncel"
    title="Haberler ve Duyurular"
    lede="Tiyatromuzdan son haberler, yeni sezon duyuruları, basın yansımaları ve etkinlik detayları."
  />

  <Section tone="paper">
    <Container>
      {announcements.length > 0 ? (
        <div class="grid md:grid-cols-2 gap-6">
          {announcements.map((item) => (
            <AnnouncementCard
              title={item.data.title}
              date={item.data.date}
              summary={item.data.summary}
              href={item.data.externalUrl || `/haberler/${item.id}`}
            />
          ))}
        </div>
      ) : (
        <p class="text-stone">Henüz yayınlanmış bir haber veya duyuru bulunmuyor.</p>
      )}
    </Container>
  </Section>
</Layout>