---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import PerdeMark from '../components/PerdeMark.astro';
import Statistic from '../components/Statistic.astro';
import Card from '../components/Card.astro';
import PlayCard from '../components/PlayCard.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import { SITE } from '../lib/site';

const homepageCollection = await getCollection('homepage');
const homepageEntry =
  homepageCollection.find((entry) => entry.id === 'homepage.md') ??
  homepageCollection.find((entry) => entry.id === 'homepage') ??
  homepageCollection.find((entry) => entry.slug === 'homepage') ??
  homepageCollection[0];
if (!homepageEntry) {
  throw new Error('Homepage content not found');
}
const homepage = homepageEntry.data;

const plays = (await getCollection('plays'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

---

<Layout title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="relative pt-40 pb-24 md:pt-52 md:pb-32 bg-curtain overflow-hidden text-paper">
    <div class="absolute inset-0 pointer-events-none opacity-30" style="background: radial-gradient(circle at 90% 10%, var(--color-gold) 0%, transparent 40%);"></div>
    <div class="absolute inset-0 pointer-events-none opacity-10" style="background: radial-gradient(circle at 10% 80%, var(--color-gold) 0%, transparent 35%);"></div>
    <Container class="relative">
      {homepage.heroEyebrow && (
        <p class="eyebrow !text-gold mb-7" data-tina-field={tinaField(homepage, 'heroEyebrow')}>
          {homepage.heroEyebrow}
        </p>
      )}
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.95] max-w-5xl text-paper">
        <span data-tina-field={tinaField(homepage, 'heroTitleStart')}>{homepage.heroTitleStart}</span>
        {homepage.heroTitleHighlight && (
          <span class="text-gold" data-tina-field={tinaField(homepage, 'heroTitleHighlight')}>
            {' '}{homepage.heroTitleHighlight}{' '}
          </span>
        )}
        <span data-tina-field={tinaField(homepage, 'heroTitleEnd')}>{homepage.heroTitleEnd}</span>
      </h1>
      <p class="mt-8 text-lg md:text-xl text-paper/85 max-w-2xl leading-relaxed" data-tina-field={tinaField(homepage, 'heroSubtitle')}>
        {homepage.heroSubtitle}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-tina-field={tinaField(homepage, 'heroButtons')}>
        {homepage.heroButtons.map((button) => (
          <a href={button.href} class="btn-primary">
            {button.label}
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Stats -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8" data-tina-field={tinaField(homepage, 'stats')}>
        {homepage.stats.map((stat) => (
          <Statistic value={stat.value} label={stat.label} />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Audience paths -->
  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Size Nasıl Yardımcı Olabiliriz?</p>
      <h2 class="text-4xl md:text-5xl mb-12">Herkes için bir kapı</h2>
      <div class="grid sm:grid-cols-2 gap-6" data-tina-field={tinaField(homepage, 'audiencePaths')}>
        {homepage.audiencePaths.map((item) => (
          <Card href={item.href}>
            <h3 class="text-2xl mb-3 group-hover:text-curtain transition-colors">{item.title}</h3>
            <p class="text-stone leading-relaxed mb-5">{item.description}</p>
            <span class="text-sm font-bold text-curtain">{item.cta} →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <PerdeMark align="center" class="!py-4" />

  <!-- Featured plays -->
  {plays.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
          <div>
            <p class="eyebrow mb-5">Repertuvar</p>
            <h2 class="text-4xl md:text-5xl">Bu sezon sahnede</h2>
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="/bilet" class="btn-primary !py-2.5 !px-5 !text-sm !shadow-none">
              Bilet Al
            </a>
            <a href="/performanslar" class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap self-center">
              Tüm oyunlar →
            </a>
          </div>
        </div>
        <div>
          {plays.map((play) => (
            <PlayCard
              title={play.data.title}
              slug={play.id}
              category={play.data.category}
              status={play.data.status}
              synopsis={play.data.synopsis}
              ageRange={play.data.ageRange}
              duration={play.data.duration}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Why Çan -->
  <Section tone="ink">
    <Container>
      {homepage.whyEyebrow && (
        <p class="eyebrow !text-gold mb-5" data-tina-field={tinaField(homepage, 'whyEyebrow')}>
          {homepage.whyEyebrow}
        </p>
      )}
      <h2 class="text-4xl md:text-5xl text-paper max-w-2xl mb-14" data-tina-field={tinaField(homepage, 'whyTitle')}>
        {homepage.whyTitle}
      </h2>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8" data-tina-field={tinaField(homepage, 'whyItems')}>
        {homepage.whyItems.map((item) => (
          <div>
            <p class="font-display text-3xl text-gold mb-3">{item.number}</p>
            <h3 class="text-xl text-paper mb-2 font-body font-bold">{item.title}</h3>
            <p class="text-paper/65 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Announcements -->
  {announcements.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-4">
          <div>
            <p class="eyebrow mb-5">{homepage.announcementsTitle ?? 'Duyurular'}</p>
            <h2 class="text-4xl md:text-5xl">{homepage.announcementsTitle ?? 'Güncel'}</h2>
          </div>
          {homepage.announcementsCtaHref && homepage.announcementsCtaLabel ? (
            <a href={homepage.announcementsCtaHref} class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap">
              {homepage.announcementsCtaLabel}
            </a>
          ) : (
            <a href="/basin/basinda-biz" class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap">
              Tüm haberler →
            </a>
          )}
        </div>
        <div>
          {announcements.map((a) => (
            <AnnouncementCard title={a.data.title} date={a.data.date} summary={a.data.summary} href={a.data.href} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Bottom CTA -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow mb-5">Sahneye Bekleriz</p>
        <h2 class="text-4xl md:text-5xl mb-6" data-tina-field={tinaField(homepage, 'ctaTitle')}>
          {homepage.ctaTitle}
        </h2>
        <p class="text-stone text-lg mb-10 leading-relaxed" data-tina-field={tinaField(homepage, 'ctaDescription')}>
          {homepage.ctaDescription}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          {homepage.ctaPrimaryHref && (
            <a href={homepage.ctaPrimaryHref} class="btn-primary" data-tina-field={tinaField(homepage, 'ctaPrimaryLabel')}>
              {homepage.ctaPrimaryLabel}
            </a>
          )}
          {homepage.ctaSecondaryHref && homepage.ctaSecondaryLabel && (
            <a href={homepage.ctaSecondaryHref} class="btn-secondary" data-tina-field={tinaField(homepage, 'ctaSecondaryLabel')}>
              {homepage.ctaSecondaryLabel}
            </a>
          )}
        </div>
      </div>
    </Container>
  </Section>
</Layout>
