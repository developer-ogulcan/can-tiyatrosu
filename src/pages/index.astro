---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import PerdeMark from '../components/PerdeMark.astro';
import Statistic from '../components/Statistic.astro';
import Card from '../components/Card.astro';
import PlayCard from '../components/PlayCard.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import { SITE } from '../lib/site';

const plays = (await getCollection('plays'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const audiencePaths = [
  {
    title: 'Seyirci misiniz?',
    description: 'Repertuvarımızdaki oyunları keşfedin, bilet alın veya okul grubunuzla gelmek için bilgi edinin.',
    href: '/bilet',
    cta: 'Bilet Al',
  },
  {
    title: 'Ekibe katılmak mı istiyorsunuz?',
    description: 'Oyuncu, yönetmen, yazar, teknik ekip — tiyatro bünyesinde görev almak isteyen herkes başvurabilir.',
    href: '/basvurular/ekip-basvurusu',
    cta: 'Ekip Başvurusu',
  },
  {
    title: 'Hobi olarak tiyatro mu yapmak istiyorsunuz?',
    description: 'Çan Akademi, ana ekibe dahil olmadan yazıp yönetip oynayabileceğiniz özgür bir üretim alanıdır.',
    href: '/can-akademi',
    cta: 'Çan Akademi',
  },
  {
    title: 'Çocuğunuz için atölye mi arıyorsunuz?',
    description: 'Dönemsel oyunculuk, yaratıcı drama ve sahne atölyelerimizi inceleyin.',
    href: '/atolyeler',
    cta: 'Atölyeler',
  },
];
---

<Layout title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="relative pt-40 pb-24 md:pt-52 md:pb-32 bg-curtain overflow-hidden text-paper">
    <div class="absolute inset-0 pointer-events-none opacity-30" style="background: radial-gradient(circle at 90% 10%, var(--color-gold) 0%, transparent 40%);"></div>
    <div class="absolute inset-0 pointer-events-none opacity-10" style="background: radial-gradient(circle at 10% 80%, var(--color-gold) 0%, transparent 35%);"></div>
    <Container class="relative">
      <p class="eyebrow !text-gold mb-7">1984'ten Bu Yana Sahnede</p>
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.95] max-w-5xl text-paper">
        Türkiye'nin yaşayan
        <span class="text-gold"> en eski </span>
        çocuk ve gençlik tiyatrosu
      </h1>
      <p class="mt-8 text-lg md:text-xl text-paper/85 max-w-2xl leading-relaxed">
        {SITE.description}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/bilet" class="btn-primary">
          Bilet Al
        </a>
        <a href="/performanslar" class="inline-flex items-center justify-center rounded-md border-2 border-paper/40 text-paper px-7 py-3.5 text-sm font-bold tracking-wide hover:bg-paper/10 transition-colors">
          Oyunları Gör
        </a>
      </div>
    </Container>
  </section>

  <!-- Stats -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8">
        <Statistic value="43" label="Yıllık Kesintisiz Üretim" />
        <Statistic value="2" label="Sahne — Kenan Halis ve Murat Celal" />
        <Statistic value="Ankara" label="Merkez Yerleşke" />
      </div>
    </Container>
  </Section>

  <!-- Audience paths -->
  <Section tone="paper">
    <Container>
      <p class="eyebrow mb-5">Size Nasıl Yardımcı Olabiliriz?</p>
      <h2 class="text-4xl md:text-5xl mb-12">Herkes için bir kapı</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {audiencePaths.map((item) => (
          <Card href={item.href}>
            <h3 class="text-2xl mb-3 group-hover:text-curtain transition-colors">{item.title}</h3>
            <p class="text-stone leading-relaxed mb-5">{item.description}</p>
            <span class="text-sm font-bold text-curtain">{item.cta} →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <PerdeMark align="center" class="!py-4" />

  <!-- Featured plays -->
  {plays.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
          <div>
            <p class="eyebrow mb-5">Repertuvar</p>
            <h2 class="text-4xl md:text-5xl">Bu sezon sahnede</h2>
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="/bilet" class="btn-primary !py-2.5 !px-5 !text-sm !shadow-none">
              Bilet Al
            </a>
            <a href="/performanslar" class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap self-center">
              Tüm oyunlar →
            </a>
          </div>
        </div>
        <div>
          {plays.map((play) => (
            <PlayCard
              title={play.data.title}
              slug={play.id}
              category={play.data.category}
              status={play.data.status}
              synopsis={play.data.synopsis}
              ageRange={play.data.ageRange}
              duration={play.data.duration}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Why Çan -->
  <Section tone="ink">
    <Container>
      <p class="eyebrow !text-gold mb-5">Neden Çan Tiyatrosu?</p>
      <h2 class="text-4xl md:text-5xl text-paper max-w-2xl mb-14">Sahne, seyirci ve üretenler için</h2>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8">
        <div>
          <p class="font-display text-3xl text-gold mb-3">01</p>
          <h3 class="text-xl text-paper mb-2 font-body font-bold">Canlı Sahne Deneyimi</h3>
          <p class="text-paper/65 leading-relaxed">43 yıllık repertuvar ve deneyimle çocuk, genç ve yetişkin seyirciye özel oyunlar.</p>
        </div>
        <div>
          <p class="font-display text-3xl text-gold mb-3">02</p>
          <h3 class="text-xl text-paper mb-2 font-body font-bold">Açık Kapı</h3>
          <p class="text-paper/65 leading-relaxed">Ekibe katılmak isteyenler, hobi olarak üretmek isteyenler ve atölye arayan veliler için ayrı yollar.</p>
        </div>
        <div>
          <p class="font-display text-3xl text-gold mb-3">03</p>
          <h3 class="text-xl text-paper mb-2 font-body font-bold">Topluluk Ruhu</h3>
          <p class="text-paper/65 leading-relaxed">Cast ajansı değiliz — bir tiyatro topluluğuyuz. Yazar, yönetmen, oyuncu, teknik ekip bir arada üretir.</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Announcements -->
  {announcements.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-4">
          <div>
            <p class="eyebrow mb-5">Duyurular</p>
            <h2 class="text-4xl md:text-5xl">Güncel</h2>
          </div>
          <a href="/basin/basinda-biz" class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap">
            Tüm haberler →
          </a>
        </div>
        <div>
          {announcements.map((a) => (
            <AnnouncementCard title={a.data.title} date={a.data.date} summary={a.data.summary} href={a.data.href} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Bottom CTA -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow mb-5">Sahneye Bekleriz</p>
        <h2 class="text-4xl md:text-5xl mb-6">Bir sonraki oyunumuzda görüşelim</h2>
        <p class="text-stone text-lg mb-10 leading-relaxed">
          Bilet almak, ekibe başvurmak veya Çan Akademi hakkında bilgi edinmek için hemen başlayın.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/bilet" class="btn-primary">Bilet Al</a>
          <a href="/basvurular/ekip-basvurusu" class="btn-secondary">Ekip Başvurusu</a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
