---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import PerdeMark from '../components/PerdeMark.astro';
import Statistic from '../components/Statistic.astro';
import Card from '../components/Card.astro';
import PlayCard from '../components/PlayCard.astro';
import Badge from '../components/Badge.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import { SITE } from '../lib/site';

const homepageCollection = await getCollection('homepage');
const homepageEntry =
  homepageCollection.find((entry) => entry.id === 'homepage.md') ??
  homepageCollection.find((entry) => entry.id === 'homepage') ??
  homepageCollection.find((entry) => entry.slug === 'homepage') ??
  homepageCollection[0];
if (!homepageEntry) {
  throw new Error('Homepage content not found');
}
const homepage: any = homepageEntry.data;

const plays = (await getCollection('plays'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 4);

let workshopsPageData: any = null;
try {
  const workshopsCol = await getCollection('workshops');
  const wEntry =
    workshopsCol.find((e) => e.id === 'workshops.md' || e.id === 'workshops' || e.slug === 'workshops') ??
    workshopsCol[0];
  workshopsPageData = wEntry?.data ?? null;
} catch {
  workshopsPageData = null;
}

let periodWorkshops: any[] = [];
try {
  const allWorkshopPages = await getCollection('workshopPages');
  const featuredOrActive = allWorkshopPages.filter(
    (p) => p.data.featured || p.data.status === 'acik' || p.data.status === 'yakinda',
  );
  const sourceList = featuredOrActive.length > 0 ? featuredOrActive : allWorkshopPages;
  const statusRank = (s: string) => (s === 'acik' ? 0 : s === 'yakinda' ? 1 : s === 'dolu' ? 2 : 3);
  periodWorkshops = sourceList
    .sort(
      (a, b) =>
        (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) ||
        statusRank(a.data.status) - statusRank(b.data.status) ||
        (a.data.order ?? 0) - (b.data.order ?? 0),
    )
    .slice(0, 3);
} catch {
  periodWorkshops = [];
}

const continuousWorkshops = (workshopsPageData?.workshops ?? []).slice(0, 3);

const workshopStatusLabel: Record<string, string> = {
  acik: 'Kayıtlar Açık',
  yakinda: 'Yakında',
  dolu: 'Kontenjan Doldu',
  tamamlandi: 'Tamamlandı',
};

const workshopStatusTone: Record<string, 'gold' | 'curtain' | 'stone'> = {
  acik: 'curtain',
  yakinda: 'gold',
  dolu: 'stone',
  tamamlandi: 'stone',
};

const announcements = (await getCollection('announcements'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5);

const getImage = (obj: any) =>
  obj?.heroImage || obj?.coverImage || obj?.poster || obj?.image || obj?.thumbnail || null;

const heroShowcaseImage =
  getImage(homepage) || (plays.length > 0 ? getImage(plays[0].data) : null);
---

<Layout title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="relative pt-36 pb-20 md:pt-48 md:pb-28 bg-curtain overflow-hidden text-paper">
    <div
      class="absolute inset-0 pointer-events-none opacity-30"
      style="background: radial-gradient(circle at 90% 10%, var(--color-gold) 0%, transparent 40%);"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none opacity-10"
      style="background: radial-gradient(circle at 10% 80%, var(--color-gold) 0%, transparent 35%);"
    ></div>

    <Container class="relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class={heroShowcaseImage ? 'lg:col-span-7' : 'lg:col-span-12'}>
          {homepage.heroEyebrow && (
            <p class="eyebrow !text-gold leading-snug mb-6" data-tina-field={tinaField(homepage, 'heroEyebrow')}>
              {homepage.heroEyebrow}
            </p>
          )}
          <h1 class="font-display text-4xl sm:text-6xl md:text-7xl leading-[1.06] max-w-5xl text-paper">
            <span data-tina-field={tinaField(homepage, 'heroTitleStart')}>{homepage.heroTitleStart}</span>
            {homepage.heroTitleHighlight && (
              <span class="text-gold" data-tina-field={tinaField(homepage, 'heroTitleHighlight')}>
                {' '}{homepage.heroTitleHighlight}{' '}
              </span>
            )}
            <span data-tina-field={tinaField(homepage, 'heroTitleEnd')}>{homepage.heroTitleEnd}</span>
          </h1>
          <p class="mt-7 text-lg md:text-xl text-paper/85 max-w-2xl leading-loose" data-tina-field={tinaField(homepage, 'heroSubtitle')}>
            {homepage.heroSubtitle}
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4" data-tina-field={tinaField(homepage, 'heroButtons')}>
            {homepage.heroButtons?.map((button: any) => (
              <a href={button.href} class="btn-primary">
                {button.label}
              </a>
            ))}
          </div>
        </div>

        {heroShowcaseImage && (
          <div class="lg:col-span-5">
            <div class="relative rounded-2xl overflow-hidden border-2 border-gold/30 bg-ink/40 shadow-2xl aspect-[2/3] max-w-sm mx-auto lg:ml-auto">
              <img
                src={heroShowcaseImage}
                alt={homepage.spotlightTitle ?? plays[0]?.data?.title ?? SITE.name}
                class="w-full h-full object-cover object-top"
              />
              {plays[0] && (
                <a
                  href={`/performanslar/${plays[0].id}`}
                  class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-ink/95 via-ink/65 to-transparent text-paper hover:text-gold transition-colors"
                >
                  <p
                    class="text-xs uppercase tracking-wider text-gold font-bold leading-snug mb-1.5"
                    data-tina-field={tinaField(homepage, 'spotlightEyebrow')}
                  >
                    {homepage.spotlightEyebrow ?? 'Sahnede Öne Çıkan'}
                  </p>
                  <p
                    class="font-display text-2xl leading-snug"
                    data-tina-field={tinaField(homepage, 'spotlightTitle')}
                  >
                    {homepage.spotlightTitle ?? plays[0].data.title}
                  </p>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </Container>
  </section>

  <!-- Stats -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8" data-tina-field={tinaField(homepage, 'stats')}>
        {homepage.stats?.map((stat: any) => (
          <Statistic value={stat.value} label={stat.label} />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Audience paths -->
  <Section tone="paper">
    <Container>
      <p class="eyebrow leading-snug mb-4" data-tina-field={tinaField(homepage, 'audienceEyebrow')}>
        {homepage.audienceEyebrow ?? 'Size Nasıl Yardımcı Olabiliriz?'}
      </p>
      <h2 class="text-4xl md:text-5xl leading-tight mb-12" data-tina-field={tinaField(homepage, 'audienceTitle')}>
        {homepage.audienceTitle ?? 'Herkes için bir kapı'}
      </h2>
      <div class="grid sm:grid-cols-2 gap-6" data-tina-field={tinaField(homepage, 'audiencePaths')}>
        {homepage.audiencePaths?.map((item: any) => (
          <Card href={item.href}>
            {getImage(item) && (
              <div class="mb-5 -mx-6 -mt-6 overflow-hidden rounded-t-xl aspect-[16/9] bg-stone/10">
                <img
                  src={getImage(item)}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            )}
            <h3 class="text-2xl leading-snug mb-3 group-hover:text-curtain transition-colors">{item.title}</h3>
            <p class="text-stone leading-relaxed mb-5">{item.description}</p>
            <span class="text-sm font-bold text-curtain">{item.cta} →</span>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <PerdeMark align="center" class="!py-4" />

  <!-- Featured plays -->
  {plays.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
          <div>
            <p class="eyebrow leading-snug mb-4" data-tina-field={tinaField(homepage, 'playsEyebrow')}>
              {homepage.playsEyebrow ?? 'Repertuvar'}
            </p>
            <h2 class="text-4xl md:text-5xl leading-tight" data-tina-field={tinaField(homepage, 'playsTitle')}>
              {homepage.playsTitle ?? 'Bu sezon sahnede'}
            </h2>
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            <a
              href="/hizmetler/kurumsal-gosterimler"
              class="text-xs font-semibold text-curtain border border-curtain/40 hover:border-curtain hover:bg-curtain hover:text-paper px-3 py-1.5 rounded transition-all duration-150 whitespace-nowrap"
            >
              Okul / Kreş Gösterimleri
            </a>
            <a href="/bilet" class="btn-primary !py-1.5 !px-4 !text-xs !shadow-none">
              Bilet Al
            </a>
            <a href="/performanslar" class="text-xs font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap ml-1">
              Tüm oyunlar →
            </a>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {plays.map((play) => {
            const img = getImage(play.data);
            return (
              <a
                href={`/performanslar/${play.id}`}
                class="group flex flex-col overflow-hidden rounded-xl border-2 border-hairline bg-paper hover:border-curtain/40 transition-colors"
              >
                {img && (
                  <div class="overflow-hidden bg-stone/10 aspect-[2/3]">
                    <img
                      src={img}
                      alt={play.data.title}
                      class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-5 flex-1 flex flex-col">
                  <div class="flex flex-wrap items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-curtain mb-2">
                    {play.data.category && <span>{play.data.category}</span>}
                    {play.data.ageRange && <span class="text-stone">• {play.data.ageRange}</span>}
                  </div>
                  <h3 class="text-xl leading-snug mb-2 group-hover:text-curtain transition-colors font-bold">{play.data.title}</h3>
                  {play.data.synopsis && (
                    <p class="text-sm text-stone leading-relaxed mb-4 line-clamp-3">{play.data.synopsis}</p>
                  )}
                  <span class="mt-auto text-sm font-bold text-curtain">İncele →</span>
                </div>
              </a>
            );
          })}
        </div>

        <div class="sr-only">
          {plays.map((play) => (
            <PlayCard
              title={play.data.title}
              slug={play.id}
              category={play.data.category}
              status={play.data.status}
              synopsis={play.data.synopsis}
              ageRange={play.data.ageRange}
              duration={play.data.duration}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Workshops -->
  {(periodWorkshops.length > 0 || continuousWorkshops.length > 0) && (
    <Section tone="dim" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
          <div>
            <p class="eyebrow !text-curtain leading-snug mb-3" data-tina-field={tinaField(homepage, 'workshopsEyebrow')}>
              {homepage.workshopsEyebrow ?? 'Sahne & Drama Eğitimi'}
            </p>
            <h2 class="text-3xl md:text-5xl font-display leading-tight" data-tina-field={tinaField(homepage, 'workshopsTitle')}>
              {homepage.workshopsTitle ?? 'Atölyelerimiz'}
            </h2>
          </div>
          <a
            href="/atolyeler"
            class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap"
          >
            {homepage.workshopsCtaLabel ?? 'Tüm atölyeler →'}
          </a>
        </div>

        {periodWorkshops.length > 0 && (
          <div class="grid md:grid-cols-3 gap-6 mb-8">
            {periodWorkshops.map((p: any) => {
              const wImg = p.data.heroImage || p.data.cover;
              return (
                <a
                  href={`/atolyeler/${p.id}`}
                  class="group flex flex-col overflow-hidden rounded-2xl border-2 border-hairline bg-paper hover:border-curtain/45 hover:shadow-lg transition-all duration-300"
                >
                  {wImg && (
                    <div class="overflow-hidden bg-stone/10 aspect-[2/3]">
                      <img
                        src={wImg}
                        alt={p.data.title}
                        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="p-6 flex-1 flex flex-col">
                    <div class="mb-3 flex flex-wrap items-center gap-2">
                      {p.data.status && (
                        <Badge tone={workshopStatusTone[p.data.status] ?? 'curtain'}>
                          {workshopStatusLabel[p.data.status] ?? p.data.status}
                        </Badge>
                      )}
                      {p.data.ageRange && (
                        <span class="text-xs font-semibold text-stone">{p.data.ageRange}</span>
                      )}
                    </div>
                    <h3 class="text-2xl leading-snug font-bold mb-2 group-hover:text-curtain transition-colors">
                      {p.data.title}
                    </h3>
                    {p.data.synopsis && (
                      <p class="text-sm text-stone leading-relaxed line-clamp-3 mb-4">
                        {p.data.synopsis}
                      </p>
                    )}
                    {p.data.schedule && (
                      <p class="text-xs font-bold text-curtain mb-4">{p.data.schedule}</p>
                    )}
                    <span class="mt-auto text-sm font-bold text-curtain">Detayları Gör →</span>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        {continuousWorkshops.length > 0 && (
          <div class="grid md:grid-cols-3 gap-5">
            {continuousWorkshops.map((cw: any) => (
              <a
                href="/atolyeler"
                class="group rounded-xl border border-hairline bg-paper p-5 hover:border-curtain/40 transition-colors flex flex-col justify-between"
              >
                <div>
                  {cw.age && <p class="eyebrow text-xs leading-snug mb-2">{cw.age}</p>}
                  <h3 class="text-xl leading-snug font-bold text-ink mb-2 group-hover:text-curtain transition-colors">
                    {cw.title}
                  </h3>
                  {cw.duration && <p class="text-xs font-bold text-curtain mb-2">{cw.duration}</p>}
                  {cw.description && (
                    <p class="text-sm text-stone leading-relaxed line-clamp-2">{cw.description}</p>
                  )}
                </div>
                <span class="mt-4 text-xs font-bold text-curtain">Atölye Programına Git →</span>
              </a>
            ))}
          </div>
        )}
      </Container>
    </Section>
  )}

  <!-- Why Çan -->
  <Section tone="ink">
    <Container>
      {homepage.whyEyebrow && (
        <p class="eyebrow !text-gold leading-snug mb-4" data-tina-field={tinaField(homepage, 'whyEyebrow')}>
          {homepage.whyEyebrow}
        </p>
      )}
      <h2 class="text-4xl md:text-5xl text-paper max-w-2xl leading-tight mb-14" data-tina-field={tinaField(homepage, 'whyTitle')}>
        {homepage.whyTitle}
      </h2>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8" data-tina-field={tinaField(homepage, 'whyItems')}>
        {homepage.whyItems?.map((item: any) => (
          <div>
            <p class="font-display text-3xl text-gold mb-3">{item.number}</p>
            <h3 class="text-xl leading-snug text-paper mb-2 font-body font-bold">{item.title}</h3>
            <p class="text-paper/65 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Announcements -->
  {announcements.length > 0 && (
    <Section tone="paper" spacing="tight">
      <Container>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
          <div>
            <p class="eyebrow leading-snug mb-4" data-tina-field={tinaField(homepage, 'announcementsEyebrow')}>
              {homepage.announcementsEyebrow ?? homepage.announcementsTitle ?? 'Duyurular'}
            </p>
            <h2 class="text-4xl md:text-5xl leading-tight" data-tina-field={tinaField(homepage, 'announcementsTitle')}>
              {homepage.announcementsTitle ?? 'Güncel'}
            </h2>
          </div>
          <a href="/basin/basinda-biz" class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap">
            {homepage.announcementsCtaLabel ?? 'Tüm haberler →'}
          </a>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          {announcements.map((a: any) => {
            const aImg = getImage(a.data);
            const href = a.data.externalUrl || `/haberler/${a.id}`;
            return aImg ? (
              <a
                href={href}
                target={a.data.externalUrl ? '_blank' : undefined}
                rel={a.data.externalUrl ? 'noopener noreferrer' : undefined}
                class="group flex gap-4 items-center rounded-xl border border-hairline bg-paper p-4 hover:border-curtain/40 transition-colors"
              >
                <img
                  src={aImg}
                  alt={a.data.title}
                  class="w-24 h-24 shrink-0 rounded-lg object-cover bg-stone/10"
                />
                <div class="min-w-0">
                  {a.data.date && (
                    <p class="text-xs text-stone mb-1">
                      {new Date(a.data.date).toLocaleDateString('tr-TR')}
                    </p>
                  )}
                  <h3 class="font-bold text-lg leading-snug group-hover:text-curtain transition-colors line-clamp-2">
                    {a.data.title}
                  </h3>
                  {a.data.summary && (
                    <p class="text-sm text-stone mt-1 line-clamp-2">{a.data.summary}</p>
                  )}
                </div>
              </a>
            ) : (
              <AnnouncementCard
                title={a.data.title}
                date={a.data.date}
                summary={a.data.summary}
                href={href}
              />
            );
          })}
        </div>
      </Container>
    </Section>
  )}

  <!-- Bottom CTA -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow leading-snug mb-4" data-tina-field={tinaField(homepage, 'ctaEyebrow')}>
          {homepage.ctaEyebrow ?? 'Sahneye Bekleriz'}
        </p>
        <h2 class="text-4xl md:text-5xl leading-tight mb-6" data-tina-field={tinaField(homepage, 'ctaTitle')}>
          {homepage.ctaTitle}
        </h2>
        <p class="text-stone text-lg mb-10 leading-relaxed" data-tina-field={tinaField(homepage, 'ctaDescription')}>
          {homepage.ctaDescription}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          {homepage.ctaPrimaryHref && (
            <a href={homepage.ctaPrimaryHref} class="btn-primary" data-tina-field={tinaField(homepage, 'ctaPrimaryLabel')}>
              {homepage.ctaPrimaryLabel}
            </a>
          )}
          {homepage.ctaSecondaryHref && homepage.ctaSecondaryLabel && (
            <a href={homepage.ctaSecondaryHref} class="btn-secondary" data-tina-field={tinaField(homepage, 'ctaSecondaryLabel')}>
              {homepage.ctaSecondaryLabel}
            </a>
          )}
        </div>
      </div>
    </Container>
  </Section>
</Layout>