---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Accordion from '../components/Accordion.astro';

const workshopsCollection = await getCollection('workshops');
const workshopsEntry =
  workshopsCollection.find(
    (entry) => entry.id === 'workshops.md' || entry.id === 'workshops' || entry.slug === 'workshops',
  ) ?? workshopsCollection[0];
if (!workshopsEntry) {
  throw new Error('Workshops page content not found');
}
const workshopsData = workshopsEntry.data;
---

<Layout title={workshopsData.title} description={workshopsData.description || 'Çocuklar ve gençler için dönemsel oyunculuk, yaratıcı drama ve sahne atölyeleri.'}>
  <PageHero
    eyebrow={workshopsData.eyebrow}
    title={workshopsData.title}
    lede={workshopsData.lede}
    eyebrowField={tinaField(workshopsData, 'eyebrow')}
    titleField={tinaField(workshopsData, 'title')}
    ledeField={tinaField(workshopsData, 'lede')}
  />

  <Section tone="paper">
    <Container>
      <p class="text-stone text-lg max-w-2xl mb-12 leading-relaxed" data-tina-field={tinaField(workshopsData, 'description')}>
        {workshopsData.description}
      </p>
      <div class="grid md:grid-cols-3 gap-6" data-tina-field={tinaField(workshopsData, 'workshops')}>
        {workshopsData.workshops.map((w) => (
          <article class="rounded-xl border-2 border-hairline bg-paper p-6 hover:border-curtain/30 transition-colors">
            <p class="eyebrow mb-3">{w.age}</p>
            <h2 class="text-2xl mb-3">{w.title}</h2>
            <p class="text-sm font-bold text-curtain mb-4">{w.duration}</p>
            <p class="text-stone leading-relaxed">{w.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="dim" spacing="tight">
    <Container narrow>
      <h2 class="text-3xl mb-8">Sık Sorulan Sorular</h2>
      <Accordion items={workshopsData.faqs} />
    </Container>
  </Section>

  <Section tone="ink">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl text-paper mb-6">{workshopsData.ctaTitle}</h2>
        <p class="text-paper/70 text-lg mb-8 leading-relaxed" data-tina-field={tinaField(workshopsData, 'ctaDescription')}>
          {workshopsData.ctaDescription}
        </p>
        <a href={workshopsData.ctaButton?.href ?? '/iletisim'} class="btn-primary" data-tina-field={tinaField(workshopsData, 'ctaButton')}>
          {workshopsData.ctaButton?.label ?? 'İletişime Geç'}
        </a>
      </div>
    </Container>
  </Section>
</Layout>
