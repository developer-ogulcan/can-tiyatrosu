---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Badge from '../../components/Badge.astro';
import PlayCard from '../../components/PlayCard.astro';

const allPlays = (await getCollection('plays')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const childrenPlays = allPlays.filter((p) => p.data.category === 'cocuk');
const adultPlays = allPlays.filter((p) => p.data.category === 'yetiskin');
const eventPlays = allPlays.filter((p) => p.data.category === 'etkinlik');

const categoryRouteMap: Record<string, string> = {
  cocuk: 'cocuk-oyunlari',
  yetiskin: 'yetiskin-oyunlari',
  etkinlik: 'etkinlikler',
};

const statusLabel: Record<string, string> = {
  repertuvarda: 'Repertuvarda',
  yakinda: 'Yakında',
  arsiv: 'Arşiv',
};

const statusTone: Record<string, 'curtain' | 'gold' | 'stone'> = {
  repertuvarda: 'curtain',
  yakinda: 'gold',
  arsiv: 'stone',
};

const categoryCards = [
  {
    key: 'cocuk',
    href: '/performanslar/cocuk-oyunlari',
    countLabel: `${childrenPlays.length} Oyun`,
    title: 'Çocuk Oyunları',
    description: 'Genç seyirciye yönelik, pedagojik yaklaşımla sahnelenen yapımlar.',
  },
  {
    key: 'yetiskin',
    href: '/performanslar/yetiskin-oyunlari',
    countLabel: `${adultPlays.length} Oyun`,
    title: 'Yetişkin Oyunları',
    description: 'Yetişkin seyirci için sahnelenen, farklı bir dramaturjik dil taşıyan yapımlar.',
  },
  {
    key: 'etkinlik',
    href: '/performanslar/etkinlikler',
    countLabel: `${eventPlays.length} Etkinlik`,
    title: 'Etkinlikler',
    description: 'Özel gösterimler, söyleşiler ve sahne dışı buluşmalar.',
  },
];
---

<Layout
  title="Oyunlar"
  description="Çan Tiyatrosu repertuvarındaki çocuk ve yetişkin oyunları ile etkinlikler."
>
  <PageHero
    eyebrow="Repertuvar"
    title="Oyunlar"
    lede="Çocuk, gençlik ve yetişkin seyirciye yönelik Çan Tiyatrosu repertuvarı ve etkinliklerimiz. Bilet almak veya detayları incelemek için seçiminizi yapın."
  />

  <!-- Kategori Kapıları -->
  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-3 gap-6">
        {categoryCards.map((cat) => (
          <a
            href={cat.href}
            class="group rounded-2xl border-2 border-hairline bg-paper p-7 hover:border-curtain/50 transition-all duration-300 flex flex-col justify-between min-h-[220px]"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="eyebrow !text-curtain">{cat.countLabel}</span>
                <span class="w-8 h-8 rounded-full border border-hairline flex items-center justify-center text-sm font-bold text-ink group-hover:bg-curtain group-hover:text-paper group-hover:border-curtain transition-colors">
                  →
                </span>
              </div>
              <h2 class="text-3xl mb-3 group-hover:text-curtain transition-colors">{cat.title}</h2>
              <p class="text-stone leading-relaxed">{cat.description}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-hairline/60 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-curtain">
              <span>Kategoriye Git</span>
              <span class="opacity-70 group-hover:translate-x-1 transition-transform">Keşfet →</span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Filtrelenebilir Repertuvar Vitrini -->
  <Section tone="dim" spacing="tight">
    <Container>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10">
        <div>
          <p class="eyebrow mb-3">Sahne Seçkisi</p>
          <h2 class="text-3xl md:text-4xl font-display">Tüm Repertuvar</h2>
        </div>

        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Repertuvar kategorisi filtrele">
          <button
            type="button"
            data-play-filter="all"
            class="play-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider border border-curtain bg-curtain text-paper transition-colors cursor-pointer"
          >
            Tümü ({allPlays.length})
          </button>
          <button
            type="button"
            data-play-filter="cocuk"
            class="play-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider border border-hairline bg-paper text-ink hover:border-curtain hover:text-curtain transition-colors cursor-pointer"
          >
            Çocuk Oyunları ({childrenPlays.length})
          </button>
          <button
            type="button"
            data-play-filter="yetiskin"
            class="play-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider border border-hairline bg-paper text-ink hover:border-curtain hover:text-curtain transition-colors cursor-pointer"
          >
            Yetişkin Oyunları ({adultPlays.length})
          </button>
          <button
            type="button"
            data-play-filter="etkinlik"
            class="play-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider border border-hairline bg-paper text-ink hover:border-curtain hover:text-curtain transition-colors cursor-pointer"
          >
            Etkinlikler ({eventPlays.length})
          </button>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7" id="repertuvar-grid">
        {allPlays.map((play) => {
          const catSlug = categoryRouteMap[play.data.category] ?? 'cocuk-oyunlari';
          const detailHref = `/performanslar/${catSlug}/${play.id}`;
          return (
            <article
              data-play-category={play.data.category}
              class="play-grid-item group flex flex-col overflow-hidden rounded-2xl border-2 border-hairline bg-paper hover:border-curtain/40 hover:shadow-lg transition-all duration-300"
            >
              <a href={detailHref} class="block overflow-hidden bg-ink aspect-[2/3]">
                {play.data.heroImage ? (
                  <img
                    src={play.data.heroImage}
                    alt={play.data.title}
                    class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center p-6 text-center text-paper/50 text-xs font-mono uppercase tracking-widest">
                    Çan Tiyatrosu Repertuvar
                  </div>
                )}
              </a>

              <div class="p-6 flex-1 flex flex-col">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <Badge tone={statusTone[play.data.status]}>
                    {statusLabel[play.data.status]}
                  </Badge>
                  {play.data.ageRange && (
                    <span class="text-xs font-semibold text-stone">{play.data.ageRange}</span>
                  )}
                  {play.data.duration && (
                    <span class="text-xs font-semibold text-stone">• {play.data.duration}</span>
                  )}
                </div>

                <h3 class="text-2xl font-bold text-ink mb-2.5 group-hover:text-curtain transition-colors">
                  <a href={detailHref}>{play.data.title}</a>
                </h3>

                {play.data.synopsis && (
                  <p class="text-sm text-stone leading-relaxed line-clamp-3 mb-5">
                    {play.data.synopsis}
                  </p>
                )}

                <div class="mt-auto pt-4 border-t border-hairline/70 flex items-center justify-between">
                  <a
                    href={detailHref}
                    class="text-sm font-bold text-curtain hover:underline underline-offset-4"
                  >
                    Detayları İncele →
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Alternatif liste bileşeni referansı -->
      <div class="sr-only">
        {allPlays.map((play) => (
          <PlayCard
            heroImage={play.data.heroImage}
            title={play.data.title}
            slug={play.id}
            category={play.data.category}
            status={play.data.status}
            synopsis={play.data.synopsis}
            ageRange={play.data.ageRange}
            duration={play.data.duration}
          />
        ))}
      </div>
    </Container>
  </Section>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll('.play-filter-btn')) as HTMLButtonElement[];
  const items = Array.from(document.querySelectorAll('.play-grid-item')) as HTMLElement[];

  const applyPlayFilter = (filter: string) => {
    buttons.forEach((btn) => {
      const active = btn.dataset.playFilter === filter;
      btn.classList.toggle('bg-curtain', active);
      btn.classList.toggle('text-paper', active);
      btn.classList.toggle('border-curtain', active);
      btn.classList.toggle('bg-paper', !active);
      btn.classList.toggle('text-ink', !active);
      btn.classList.toggle('border-hairline', !active);
    });

    items.forEach((el) => {
      const match = filter === 'all' || el.dataset.playCategory === filter;
      el.classList.toggle('hidden', !match);
    });
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyPlayFilter(btn.dataset.playFilter || 'all');
    });
  });
</script>