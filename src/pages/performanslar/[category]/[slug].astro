---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import Badge from '../../../components/Badge.astro';
import Gallery from '../../../components/Gallery.astro';
import CTA from '../../../components/CTA.astro';

export async function getStaticPaths() {
  const plays = await getCollection('plays');
  return plays.map((play) => ({
    params: {
      category: play.data.category === 'cocuk' ? 'cocuk-oyunlari' : 'yetiskin-oyunlari',
      slug: play.id,
    },
    props: { play },
  }));
}

const { play } = Astro.props;
const { Content } = await render(play);

const statusLabel: Record<string, string> = {
  repertuvarda: 'Repertuvarda',
  yakinda: 'Yakında',
  arsiv: 'Arşiv',
};
const statusTone: Record<string, 'gold' | 'curtain' | 'stone'> = {
  repertuvarda: 'curtain',
  yakinda: 'gold',
  arsiv: 'stone',
};

const backHref = play.data.category === 'cocuk' ? '/performanslar/cocuk-oyunlari' : '/performanslar/yetiskin-oyunlari';
---

<Layout title={play.data.title} description={play.data.synopsis}>
  <header class="pt-32 pb-14 md:pt-40 md:pb-16 bg-paper-dim border-b border-hairline">
    <Container>
      <a href={backHref} class="text-sm text-stone hover:text-curtain transition-colors">← Repertuvara dön</a>
      <div class="mt-6 flex items-center gap-3">
        <Badge tone={statusTone[play.data.status]}>{statusLabel[play.data.status]}</Badge>
        {play.data.ageRange && <span class="text-sm text-stone">{play.data.ageRange}</span>}
        {play.data.duration && <span class="text-sm text-stone">· {play.data.duration}</span>}
      </div>
      <h1 class="mt-5 text-4xl md:text-6xl max-w-3xl">{play.data.title}</h1>
      <p class="mt-6 text-lg text-stone max-w-2xl leading-relaxed">{play.data.synopsis}</p>
    </Container>
  </header>

  <Section tone="paper" spacing="tight">
    <Container>
      <Gallery count={6} caption={play.data.title} />
    </Container>
  </Section>

  <Section tone="paper">
    <Container>
      <div class="grid md:grid-cols-12 gap-12">
        <div class="md:col-span-8 prose-editorial text-lg text-stone leading-relaxed">
          <Content />
        </div>
        <aside class="md:col-span-4 space-y-8">
          {play.data.cast.length > 0 && (
            <div>
              <p class="eyebrow mb-3">Oyuncular</p>
              <ul class="space-y-1.5 text-ink">
                {play.data.cast.map((name: string) => <li>{name}</li>)}
              </ul>
            </div>
          )}
          {play.data.crew.length > 0 && (
            <div>
              <p class="eyebrow mb-3">Ekip</p>
              <ul class="space-y-1.5 text-ink">
                {play.data.crew.map((c: { role: string; name: string }) => (
                  <li><span class="text-stone">{c.role}:</span> {c.name}</li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </Container>
  </Section>

  <CTA
    title="Bu oyunu okulunuza veya kurumunuza taşıyalım"
    description="Kurumsal gösterim talebinizi ileterek, bu yapım için uygun tarih ve mekân planlamasını birlikte yapalım."
    primaryLabel="Gösterim Talebi Oluştur"
    primaryHref="/basvurular/kurumsal-gosterim-talebi"
    secondaryLabel="Diğer Oyunlara Bakın"
    secondaryHref="/performanslar"
  />
</Layout>
