---
import { getEntry, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import Section from "../../../components/Section.astro";
import Badge from "../../../components/Badge.astro";
import CTA from "../../../components/CTA.astro";

export const prerender = false;

const { category, slug } = Astro.params;

const play = await getEntry("plays", slug!);

if (!play) {
  return Astro.redirect("/performanslar");
}

const expectedCategory =
  play.data.category === "cocuk"
    ? "cocuk-oyunlari"
    : "yetiskin-oyunlari";

if (category !== expectedCategory) {
  return Astro.redirect(`/performanslar/${expectedCategory}/${slug}`);
}

const { Content } = await render(play);

const statusLabel = {
  repertuvarda: "Repertuvarda",
  yakinda: "Yakında",
  arsiv: "Arşiv",
};

const statusTone = {
  repertuvarda: "curtain",
  yakinda: "gold",
  arsiv: "stone",
};

const backHref =
  play.data.category === "cocuk"
    ? "/performanslar/cocuk-oyunlari"
    : "/performanslar/yetiskin-oyunlari";
---

<Layout
  title={play.data.title}
  description={play.data.synopsis}
  image={play.data.heroImage}
>

  <!-- HERO -->
  <header class="relative">

    {
      play.data.cover && (
        <img
          src={play.data.cover}
          alt={play.data.title}
          data-lightbox
          class="w-full h-[60vh] object-cover cursor-zoom-in"
        />
      )
    }

    <div class="bg-paper-dim border-b border-hairline">

      <Container class="py-14">

        <a
          href={backHref}
          class="text-sm text-stone hover:text-curtain"
        >
          ← Repertuvara dön
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-3">

          <Badge tone={statusTone[play.data.status]}>
            {statusLabel[play.data.status]}
          </Badge>

          {play.data.ageRange && (
            <span class="text-sm text-stone">
              {play.data.ageRange}
            </span>
          )}

          {play.data.duration && (
            <span class="text-sm text-stone">
              • {play.data.duration}
            </span>
          )}

        </div>

        <h1 class="mt-5 text-5xl">
          {play.data.title}
        </h1>

        <p class="mt-6 max-w-3xl text-lg text-stone">
          {play.data.synopsis}
        </p>

      </Container>

    </div>

  </header>

  {
    play.data.heroImage && (
      <div class="mt-10">
        <img
          src={play.data.heroImage}
          alt={play.data.title}
          data-lightbox
          class="w-full max-w-md rounded-2xl shadow-xl border border-hairline mx-auto cursor-zoom-in"
        />
      </div>
    )
  }

  <!-- GALERİ -->

  {
    play.data.gallery?.length > 0 && (

      <Section tone="paper" spacing="tight">

        <Container>

          <div class="grid md:grid-cols-3 gap-6">

            {play.data.gallery.map((image) => (

              <img
                src={image}
                alt={play.data.title}
                data-lightbox
                class="rounded-xl object-cover w-full aspect-[4/3] cursor-zoom-in"
              />

            ))}

          </div>

        </Container>

      </Section>

    )
  }

  <!-- İÇERİK -->

  <Section tone="paper">

    <Container>

      <div class="grid md:grid-cols-12 gap-12">

        <div class="md:col-span-8 prose-editorial">

          <Content />

        </div>

        <aside class="md:col-span-4 space-y-10">

          {
            play.data.cast?.length > 0 && (
              <div>

                <h3 class="eyebrow mb-3">
                  Oyuncular
                </h3>

                <ul class="space-y-2">

                  {play.data.cast.map((actor) => (
                    <li>{actor}</li>
                  ))}

                </ul>

              </div>
            )
          }

          {
            play.data.crew?.length > 0 && (
              <div>

                <h3 class="eyebrow mb-3">
                  Künye
                </h3>

                <ul class="space-y-2">

                  {play.data.crew.map((item) => (

                    <li>

                      <strong>{item.role}</strong><br />

                      {item.name}

                    </li>

                  ))}

                </ul>

              </div>
            )
          }

        </aside>

      </div>

    </Container>

  </Section>

  <CTA
    title="Bu oyuna bilet alın"
    description="Gösteri takvimimiz ve bilet bilgileri için bilet sayfamızı ziyaret edin."
    primaryLabel="Bilet Al"
    primaryHref="/bilet"
    secondaryLabel="Kurumsal Gösterim Talebi"
    secondaryHref="/basvurular/kurumsal-gosterim-talebi"
  />

  <!-- LIGHTBOX -->
  <dialog
    id="lightbox"
    class="m-0 w-screen h-screen max-w-none max-h-none bg-transparent p-0 backdrop:bg-black/90"
  >
    <div
      id="lightbox-stage"
      class="relative flex h-full w-full items-center justify-center p-4 md:p-10"
    >
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-full max-w-full object-contain rounded-lg shadow-2xl"
      />

      <button
        id="lightbox-close"
        type="button"
        aria-label="Kapat"
        class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/25"
      >
        ×
      </button>

      <button
        id="lightbox-prev"
        type="button"
        aria-label="Önceki görsel"
        class="absolute left-4 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/25"
      >
        ‹
      </button>

      <button
        id="lightbox-next"
        type="button"
        aria-label="Sonraki görsel"
        class="absolute right-4 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/25"
      >
        ›
      </button>

      <span
        id="lightbox-counter"
        class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white/80"
      ></span>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;

    if (dialog) {
      const stage = document.getElementById("lightbox-stage")!;
      const imgEl = document.getElementById("lightbox-img") as HTMLImageElement;
      const counter = document.getElementById("lightbox-counter")!;
      const prevBtn = document.getElementById("lightbox-prev")!;
      const nextBtn = document.getElementById("lightbox-next")!;
      const closeBtn = document.getElementById("lightbox-close")!;

      // Sayfadaki tüm tıklanabilir görseller, doküman sırasıyla
      const sources = Array.from(
        document.querySelectorAll<HTMLImageElement>(
          "[data-lightbox], .prose-editorial img"
        )
      );

      let index = 0;

      const show = (i: number) => {
        index = (i + sources.length) % sources.length;
        const src = sources[index];
        imgEl.src = src.currentSrc || src.src;
        imgEl.alt = src.alt;
        counter.textContent = `${index + 1} / ${sources.length}`;
      };

      const open = (i: number) => {
        show(i);
        dialog.showModal();
        document.body.style.overflow = "hidden";
      };

      const close = () => dialog.close();

      sources.forEach((img, i) => {
        img.classList.add("cursor-zoom-in");
        img.tabIndex = 0;
        img.setAttribute("role", "button");
        img.addEventListener("click", () => open(i));
        img.addEventListener("keydown", (e) => {
          if (e.key === "Enter") open(i);
        });
      });

      if (sources.length < 2) {
        prevBtn.hidden = true;
        nextBtn.hidden = true;
        counter.hidden = true;
      }

      prevBtn.addEventListener("click", (e) => { e.stopPropagation(); show(index - 1); });
      nextBtn.addEventListener("click", (e) => { e.stopPropagation(); show(index + 1); });
      closeBtn.addEventListener("click", close);

      // Boş alana tıklayınca kapat
      stage.addEventListener("click", (e) => {
        if (e.target === stage) close();
      });

      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
        imgEl.src = "";
      });

      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(index - 1);
        if (e.key === "ArrowRight") show(index + 1);
      });
    }
  </script>

</Layout>