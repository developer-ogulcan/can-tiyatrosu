---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import Section from "../../../components/Section.astro";
import Badge from "../../../components/Badge.astro";
import CTA from "../../../components/CTA.astro";
import Lightbox from "../../../components/Lightbox.astro";

export const prerender = false;

const { category, slug } = Astro.params;

const play = await getEntry("plays", slug!);

if (!play) {
  return Astro.redirect("/performanslar");
}

const categoryRoutes = {
  cocuk: "cocuk-oyunlari",
  yetiskin: "yetiskin-oyunlari",
  etkinlik: "etkinlikler",
} as const;

const expectedCategory = categoryRoutes[play.data.category];

if (category !== expectedCategory) {
  return Astro.redirect(`/performanslar/${expectedCategory}/${slug}`);
}

const { Content } = await render(play);

const statusLabel = {
  repertuvarda: "Repertuvarda",
  yakinda: "Yakında",
  arsiv: "Arşiv",
};

const statusTone = {
  repertuvarda: "curtain",
  yakinda: "gold",
  arsiv: "stone",
};

const categoryTitleLabel = {
  cocuk: "Çocuk Oyunu",
  yetiskin: "Yetişkin Oyunu",
  etkinlik: "Etkinlik",
}[play.data.category];

const backHref = `/performanslar/${expectedCategory}`;

const isEvent = play.data.category === "etkinlik";

/* ---------- AYNI KATEGORİDEN DİĞER ÖNERİLER ---------- */
const relatedHeading = {
  cocuk: "Diğer Çocuk Oyunları",
  yetiskin: "Diğer Yetişkin Oyunları",
  etkinlik: "Diğer Etkinlikler",
}[play.data.category];

const relatedEyebrow = {
  cocuk: "Repertuvar • Çocuk Oyunları",
  yetiskin: "Repertuvar • Yetişkin Oyunları",
  etkinlik: "Etkinlik Takvimi",
}[play.data.category];

const allPlays = await getCollection("plays");
const relatedPlays = allPlays
  .filter((item) => item.data.category === play.data.category && item.id !== play.id && item.slug !== slug)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3);

/* ---------- SEO ---------- */
const seoLabel = {
  cocuk: "Ankara Çocuk Tiyatrosu",
  yetiskin: "Ankara Tiyatro Oyunu",
  etkinlik: "Ankara Etkinliği",
} as const;

const seoTitle = play.data.seoTitle || `${play.data.title} – ${seoLabel[play.data.category]}`;
const seoDescription = play.data.seoDescription || play.data.synopsis;

const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = `${origin}/performanslar/${expectedCategory}/${slug}`;
const imageUrl = play.data.heroImage ? new URL(play.data.heroImage, origin).href : undefined;

const playLd = {
  "@type": "Play",
  "@id": `${pageUrl}#play`,
  name: play.data.title,
  description: seoDescription,
  url: pageUrl,
  inLanguage: "tr",
  image: imageUrl,
  audience: {
    "@type": "PeopleAudience",
    audienceType:
      play.data.category === "cocuk"
        ? "Çocuk ve aileler"
        : play.data.category === "yetiskin"
          ? "Yetişkin"
          : "Genel izleyici",
  },
  actor: play.data.cast.map((name) => ({ "@type": "Person", name })),
  productionCompany: { "@id": `${origin}/#organization` },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={play.data.heroImage}
  imageAlt={play.data.title}
  jsonLd={playLd}
>

  <!-- HERO -->
  <header class="relative">

    {
      play.data.cover && (
        <img
          src={play.data.cover}
          alt={play.data.title}
          data-lightbox
          class="w-full h-[52vh] md:h-[60vh] object-cover cursor-zoom-in"
        />
      )
    }

    <div class="bg-paper-dim border-b border-hairline">

      <Container class="py-12 md:py-16">

        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-stone hover:text-curtain transition-colors"
        >
          ← Repertuvara dön
        </a>

        <div class="mt-8 grid lg:grid-cols-12 gap-10 items-start">

          <div class={play.data.heroImage ? "lg:col-span-8" : "lg:col-span-12"}>

            <div class="flex flex-wrap items-center gap-3">

              <Badge tone={statusTone[play.data.status]}>
                {statusLabel[play.data.status]}
              </Badge>

              <span class="text-xs font-bold uppercase tracking-wider text-curtain">
                {categoryTitleLabel}
              </span>

              {play.data.ageRange && (
                <span class="text-sm text-stone">
                  • {play.data.ageRange}
                </span>
              )}

              {play.data.duration && (
                <span class="text-sm text-stone">
                  • {play.data.duration}
                </span>
              )}

            </div>

            <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl leading-tight">
              {play.data.title}
            </h1>

            <p class="mt-6 max-w-3xl text-lg md:text-xl text-stone leading-relaxed">
              {play.data.synopsis}
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="/bilet" class="btn-primary">
                {isEvent ? "Etkinlik Bileti Al" : "Bilet Al"}
              </a>
              <a href="/basvurular/kurumsal-gosterim-talebi" class="btn-secondary">
                Kurumsal / Okul Talebi
              </a>
            </div>

          </div>

          {
            play.data.heroImage && (
              <div class="lg:col-span-4">
                <div class="max-w-xs mx-auto lg:ml-auto rounded-2xl overflow-hidden border-2 border-hairline bg-paper shadow-xl">
                  <img
                    src={play.data.heroImage}
                    alt={play.data.title}
                    data-lightbox
                    class="w-full aspect-[2/3] object-cover object-top cursor-zoom-in transition-transform duration-300 hover:scale-[1.02]"
                  />
                </div>
              </div>
            )
          }

        </div>

      </Container>

    </div>

  </header>

  <!-- GALERİ -->

  {
    play.data.gallery?.length > 0 && (

      <Section tone="paper" spacing="tight">

        <Container>

          <p class="eyebrow !text-curtain mb-2">Sahne Kareleri</p>
          <h2 class="text-2xl md:text-3xl mb-6">Oyundan Görseller</h2>

          <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">

            {play.data.gallery.map((image) => (

              <img
                src={image}
                alt={play.data.title}
                data-lightbox
                class="rounded-xl border border-hairline object-cover w-full aspect-[4/3] cursor-zoom-in hover:border-curtain/40 transition-colors"
              />

            ))}

          </div>

        </Container>

      </Section>

    )
  }

  <!-- İÇERİK -->

  <Section tone="paper">

    <Container>

      <div class="grid lg:grid-cols-12 gap-12 items-start">

        <div class="lg:col-span-8 prose-editorial">

          <Content />

        </div>

        <aside class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">

          {
            (play.data.cast?.length > 0 || play.data.crew?.length > 0) && (
              <div class="rounded-2xl border border-hairline bg-paper-dim p-6 space-y-8">

                {
                  play.data.cast?.length > 0 && (
                    <div>

                      <h3 class="eyebrow !text-curtain mb-3">
                        Oyuncular
                      </h3>

                      <ul class="space-y-2 text-sm text-ink">

                        {play.data.cast.map((actor) => (
                          <li class="border-b border-hairline/50 pb-1.5 last:border-b-0 last:pb-0">
                            {actor}
                          </li>
                        ))}

                      </ul>

                    </div>
                  )
                }

                {
                  play.data.crew?.length > 0 && (
                    <div>

                      <h3 class="eyebrow !text-curtain mb-3">
                        Künye
                      </h3>

                      <ul class="space-y-3 text-sm">

                        {play.data.crew.map((item) => (

                          <li class="border-b border-hairline/50 pb-2 last:border-b-0 last:pb-0">

                            <span class="block text-xs uppercase tracking-wider text-stone font-semibold">
                              {item.role}
                            </span>
                            <span class="font-bold text-ink">
                              {item.name}
                            </span>

                          </li>

                        ))}

                      </ul>

                    </div>
                  )
                }

              </div>
            )
          }

        </aside>

      </div>

    </Container>

  </Section>

  <!-- AYNI KATEGORİDEN DİĞER ÖNERİLER -->

  {
    relatedPlays.length > 0 && (
      <Section tone="dim" spacing="tight">
        <Container>
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
            <div>
              <p class="eyebrow !text-curtain mb-2">{relatedEyebrow}</p>
              <h2 class="text-3xl md:text-4xl">{relatedHeading}</h2>
            </div>
            <a
              href={backHref}
              class="text-sm font-bold text-curtain hover:underline underline-offset-4 whitespace-nowrap"
            >
              Tümünü gör →
            </a>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPlays.map((item) => (
              <a
                href={`/performanslar/${expectedCategory}/${item.id}`}
                class="group flex flex-col overflow-hidden rounded-xl border-2 border-hairline bg-paper hover:border-curtain/40 transition-colors"
              >
                {item.data.heroImage && (
                  <div class="overflow-hidden bg-stone/10 aspect-[2/3]">
                    <img
                      src={item.data.heroImage}
                      alt={item.data.title}
                      class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-5 flex-1 flex flex-col">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <Badge tone={statusTone[item.data.status]}>
                      {statusLabel[item.data.status]}
                    </Badge>
                    {item.data.ageRange && (
                      <span class="text-xs text-stone">{item.data.ageRange}</span>
                    )}
                  </div>
                  <h3 class="text-xl font-bold mb-2 group-hover:text-curtain transition-colors">
                    {item.data.title}
                  </h3>
                  {item.data.synopsis && (
                    <p class="text-sm text-stone leading-relaxed line-clamp-3 mb-4">
                      {item.data.synopsis}
                    </p>
                  )}
                  <span class="mt-auto text-sm font-bold text-curtain">
                    {isEvent ? "Etkinliği İncele →" : "Oyunu İncele →"}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <CTA
    title={isEvent ? "Bu etkinliğe bilet alın" : "Bu oyuna bilet alın"}
    description="Gösteri takvimimiz ve bilet bilgileri için bilet sayfamızı ziyaret edin."
    primaryLabel="Bilet Al"
    primaryHref="/bilet"
    secondaryLabel="Kurumsal Gösterim Talebi"
    secondaryHref="/basvurular/kurumsal-gosterim-talebi"
  />

  <Lightbox />

</Layout>