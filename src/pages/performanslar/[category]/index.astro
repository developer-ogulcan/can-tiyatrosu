---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import PlayCard from '../../../components/PlayCard.astro';

const { category } = Astro.params;

// URL'deki kategori adını content schema'daki karşılığına dönüştür
const categoryMap: Record<string, { key: 'cocuk' | 'yetiskin'; label: string; lede: string }> = {
  'cocuk-oyunlari': {
    key: 'cocuk',
    label: 'Çocuk Oyunları',
    lede: 'Çocuk ve gençlik seyircisine yönelik, pedagojik yaklaşımla hazırlanan yapımlarımız.',
  },
  'yetiskin-oyunlari': {
    key: 'yetiskin',
    label: 'Yetişkin Oyunları',
    lede: 'Yetişkin seyirci için sahnelenen, farklı bir dramaturjik dil taşıyan yapımlarımız.',
  },
};

const currentCategory = categoryMap[category || ''];

if (!currentCategory) {
  return Astro.redirect('/performanslar');
}

const plays = (await getCollection('plays'))
  .filter((p) => p.data.category === currentCategory.key)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title={currentCategory.label} description={currentCategory.lede}>
  <PageHero eyebrow="Repertuvar" title={currentCategory.label} lede={currentCategory.lede} />

  <Section tone="paper">
    <Container>
      {plays.length > 0 ? (
        <div class="space-y-6">
          {plays.map((play) => (
            <PlayCard
              title={play.data.title}
              slug={play.id}
              category={play.data.category}
              status={play.data.status}
              synopsis={play.data.synopsis}
              ageRange={play.data.ageRange}
              duration={play.data.duration}
              heroImage={play.data.heroImage}
            />
          ))}
        </div>
      ) : (
        <p class="text-stone">[Bu kategoriye ait oyunlar yakında eklenecektir.]</p>
      )}
    </Container>
  </Section>
</Layout>